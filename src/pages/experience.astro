---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import { renderMarkdown } from '../utils/markdown';
import exp from '../data/pages/experience.json';
import settings from '../data/settings.json';

const hasTestimonials = exp.testimonials && exp.testimonials.length > 0;
const introHtml       = await renderMarkdown(exp.intro);
---

<Base
  title={`Experience — ${settings.professional_name}`}
  description={exp.meta_description}
>
  <div class="page-header">
    <div class="container">
      <h1>Experience</h1>
      <p>{exp.page_subtitle}</p>
    </div>
  </div>

  <!-- Intro -->
  <section>
    <div class="container container-narrow">
      <div class="experience-intro" set:html={introHtml} />
    </div>
  </section>

  <!-- States served -->
  {exp.states_served.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{exp.states_label}</span>
          <h2>{exp.states_headline}</h2>
          <p>{exp.states_note}</p>
        </div>
        <div class="states-grid">
          {exp.states_served.map((s) => (
            <div class="state-card">
              <p class="state-name">{s.state}</p>
              <p class="state-note">{s.note}</p>
            </div>
          ))}
        </div>
        <p class="section-aside">
          The <a href="/#coverage">coverage map</a> breaks these down by basin and play.
        </p>
      </div>
    </section>
  )}

  <!-- Project types -->
  {exp.project_types.length > 0 && (
    <section>
      <div class="container">
        <div class="section-header">
          <span class="section-label">{exp.project_types_label}</span>
          <h2>{exp.project_types_headline}</h2>
        </div>
        <ul class="project-types-list" role="list">
          {exp.project_types.map((p) => (
            <li>{p.label}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {hasTestimonials && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{exp.testimonials_label}</span>
          <h2>{exp.testimonials_headline}</h2>
        </div>
        <div class="testimonials-grid">
          {exp.testimonials.map((t) => (
            <figure class="testimonial-card">
              <blockquote>
                <p class="testimonial-quote">{t.quote}</p>
              </blockquote>
              <figcaption>
                <span class="testimonial-name">{t.attribution_name}</span>
                {t.attribution_title && (
                  <span class="testimonial-title">{t.attribution_title}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CallToAction
    headline={exp.cta.headline}
    text={exp.cta.text}
    button={exp.cta.button}
    tone="light"
  />
</Base>
