---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';
import about from '../data/pages/about.json';
import settings from '../data/settings.json';

const bioHtml      = await renderMarkdown(about.bio);
const approachHtml = await renderMarkdown(about.approach);

// About covers the firm; Team covers the people. The two pages describe overlapping
// ground, so point at the fuller treatment rather than leaving the reader to find it.
let hasPeople = false;
try {
  hasPeople = (await getCollection('people')).length > 0;
} catch {
  hasPeople = false;
}
---

<Base
  title={`About — ${settings.professional_name}`}
  description={about.meta_description}
>
  <!-- ─── Page header ─── -->
  <div class="page-header">
    <div class="container">
      <h1>About</h1>
      <p>{about.page_subtitle}</p>
    </div>
  </div>

  <!-- ─── Bio + photo ─── -->
  <section>
    <div class="container">
      <div class={about.headshot ? 'about-grid' : 'about-full'}>
        <!-- Photo column — only rendered when a headshot is set -->
        {about.headshot && (
          <div class="about-photo-col">
            <img
              src={about.headshot}
              alt=""
              class="about-photo"
            />
          </div>
        )}

        <!-- Text column -->
        <div>
          <div class="about-section about-bio" set:html={bioHtml} />

          {about.credentials.length > 0 && (
            <div class="about-section">
              <h2>Credentials</h2>
              <ul class="credentials-list" role="list">
                {about.credentials.map((c) => (
                  <li class="credential-item">
                    <span class="credential-name">{c.name}</span>
                    <span class="credential-meta">{c.issuer}{c.year ? ` · ${c.year}` : ''}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {about.affiliations.length > 0 && (
            <div class="about-section">
              <h2>Affiliations</h2>
              <ul class="affiliations-list" role="list">
                {about.affiliations.map((a) => (
                  <li>
                    {a.url
                      ? <a href={a.url} class="affiliation-tag" target="_blank" rel="noopener noreferrer">{a.name}</a>
                      : <span class="affiliation-tag">{a.name}</span>
                    }
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      <!-- Approach block — full width below the grid -->
      <div class="approach-section">
        <h2>{about.approach_headline}</h2>
        <div class="approach-body" set:html={approachHtml} />
      </div>

      {hasPeople && (
        <p class="section-aside">
          Full background on each landman is on the <a href="/people">team page</a>.
        </p>
      )}
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <CallToAction
    headline={about.cta.headline}
    text={about.cta.text}
    button={about.cta.button}
    tone="light"
  />
</Base>
