---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import { getCollection, render } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';
import { text } from '../utils/labels';
import about from '../data/pages/about.json';
import settings from '../data/settings.json';
import LinkedInIcon from '../components/LinkedInIcon.astro';

const introHtml    = await renderMarkdown(about.intro);
const approachHtml = await renderMarkdown(about.approach);

// About and Team were separate pages describing overlapping ground: About named both
// landmen and their credential, which Team then repeated with full bios. They are one page
// now. How We Work is the part that belonged to neither, so it leads.
let people: Awaited<ReturnType<typeof getCollection<'people'>>> = [];
try {
  people = await getCollection('people');
} catch {
  people = [];
}

const sorted = [...people].sort(
  (a, b) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0)
);

const rendered = await Promise.all(
  sorted.map(async (person) => {
    const { Content }    = await render(person);
    const experienceHtml = await renderMarkdown(person.data.experience_details);
    return { person, Content, experienceHtml };
  })
);

// A credential reads as one line: the name, then who issued it, the year and the number
// when those are filled in. Blank parts are left out rather than shown empty.
// A credential that just restates the person's role (the role "Certified Professional
// Landman" and the credential "Certified Professional Landman (CPL)") would print the same
// words twice. In that case only its details (issuer, year, number) are shown, right under
// the role, which already names it.
const plain = (s: string) => s.replace(/\(.*?\)/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
function restatesRole(credentialName: string, role?: string | null) {
  return Boolean(role) && plain(credentialName) === plain(role!);
}

function credentialLine(c: { name: string; issuer?: string | null; year?: string; number?: string }) {
  return [
    c.issuer,
    c.year && `since ${c.year}`,
    c.number && `No. ${c.number}`,
  ].filter(Boolean).join(' · ');
}

// The company-wide list. Typed here because the file ships with it empty, which would
// otherwise leave TypeScript thinking it can never hold anything.
type Credential = { name: string; issuer?: string | null; year?: string; number?: string };
const companyCredentials = (about.credentials ?? []) as Credential[];

// One Person entry per landman. Credentials come from each person's own list, so someone
// added without a CPL is never described to search engines as holding one. Only emitted
// when there is somebody to describe.
const schema = sorted.length > 0
  ? {
      '@context': 'https://schema.org',
      '@graph': sorted.map((person) => ({
        '@type': 'Person',
        name: person.data.name,
        ...(person.data.role ? { jobTitle: person.data.role } : {}),
        ...(person.data.credentials.length > 0
          ? {
              hasCredential: person.data.credentials.map((c) => ({
                '@type': 'EducationalOccupationalCredential',
                credentialCategory: 'professional certification',
                name: c.name,
                ...(c.issuer ? { recognizedBy: { '@type': 'Organization', name: c.issuer } } : {}),
              })),
            }
          : {}),
        worksFor: { '@id': new URL('/#org', Astro.site).toString(), name: settings.professional_name },
        ...(person.data.photo ? { image: new URL(person.data.photo, Astro.site).toString() } : {}),
        ...(person.data.linkedin_url ? { sameAs: [person.data.linkedin_url] } : {}),
      })),
    }
  : undefined;
---

<Base
  title={about.page_title}
  description={about.meta_description}
  schema={schema}
>
  <div class="page-header">
    <div class="container">
      <h1>{text(about.page_heading, 'About')}</h1>
      <p>{about.page_subtitle}</p>
    </div>
  </div>

  <!-- ─── The people. Hidden entirely when nobody is listed, so the page above survives. ─── -->
  {rendered.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{about.team_label}</span>
          <h2>{about.team_headline}</h2>
        </div>

        <div class="people-grid">
          {rendered.map(({ person, Content, experienceHtml }) => (
            <article class="person-card">
              {person.data.photo
                ? <img
                    src={person.data.photo}
                    alt={`${person.data.name}, professional photo`}
                    class="person-photo"
                    width="800"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                : <div class="person-photo-placeholder" aria-hidden="true">👤</div>
              }

              <div class="person-info">
                <h3 class="person-name">{person.data.name}</h3>
                {person.data.role && (
                  <p class="person-role">{person.data.role}</p>
                )}

                {(() => {
                  // A credential that only restates the role, with no details, adds nothing
                  // to show; if that leaves none, no list is drawn at all.
                  const items = person.data.credentials
                    .map((c) => ({
                      c,
                      sameAsRole: restatesRole(c.name, person.data.role),
                      details: credentialLine(c),
                    }))
                    .filter((i) => !i.sameAsRole || i.details);
                  return items.length > 0 && (
                    <ul class="person-credentials" role="list">
                      {items.map(({ c, sameAsRole, details }) => (
                        <li>
                          {!sameAsRole && <span class="person-credential-name">{c.name}</span>}
                          {details && <span class="person-credential-meta">{details}</span>}
                        </li>
                      ))}
                    </ul>
                  );
                })()}

                {person.data.linkedin_url && (
                  <p class="person-linkedin">
                    <a
                      href={person.data.linkedin_url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <LinkedInIcon size={16} />
                      <span>{person.data.name} on LinkedIn</span>
                    </a>
                  </p>
                )}

                <div class="person-bio">
                  <Content />
                </div>

                {person.data.experience_details && (
                  <div class="person-experience">
                    <span class="person-experience-label">{text(about.background_label, 'Background')}</span>
                    <div
                      class="person-experience-body"
                      set:html={experienceHtml}
                    />
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── How we work, then who we work for. The people come first, above. ─── -->
  <section>
    <div class="container container-narrow">
      <div class="approach-section">
        <h2>{about.approach_headline}</h2>
        <div class="approach-body" set:html={approachHtml} />
      </div>

      <div class="prose about-intro about-intro-after" set:html={introHtml} />
    </div>
  </section>

  <!-- ─── Firm-wide credentials, then affiliations. Personal credentials live on each
       person's card; this list is for anything that belongs to the company itself. ─── -->
  {companyCredentials.length > 0 && (
    <section class="affiliations-band affiliations-band-credentials">
      <div class="container container-narrow">
        <h2 class="affiliations-heading">{text(about.credentials_heading, 'Credentials')}</h2>
        <ul class="affiliations-list" role="list">
          {companyCredentials.map((c) => (
            <li>
              <span class="affiliation-tag">
                {c.name}{credentialLine(c) && <span class="affiliation-tag-meta"> · {credentialLine(c)}</span>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ─── Affiliations. A membership with an outbound link, not a restatement of the
       credential each person card already carries. ─── -->
  {about.affiliations?.length > 0 && (
    <section class="affiliations-band">
      <div class="container container-narrow">
        <h2 class="affiliations-heading">{text(about.affiliations_heading, 'Affiliations')}</h2>
        <ul class="affiliations-list" role="list">
          {about.affiliations.map((a) => (
            <li>
              {a.url
                ? <a href={a.url} class="affiliation-tag" target="_blank" rel="noopener noreferrer">{a.name}</a>
                : <span class="affiliation-tag">{a.name}</span>
              }
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CallToAction
    headline={about.cta.headline}
    text={about.cta.text}
    button={about.cta.button}
    tone="light"
  />
</Base>
