---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import SampleFeature from '../components/SampleFeature.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { renderMarkdown } from '../utils/markdown';
import page from '../data/pages/mineral-owners.json';
import settings from '../data/settings.json';

const introHtml = await renderMarkdown(page.intro);
const pennsylvaniaHtml = page.pennsylvania_note
  ? await renderMarkdown(page.pennsylvania_note)
  : '';

const faq = (page.faq || []).filter((f) => f.question && f.answer);

const telHref = settings.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : '';

// FAQPage markup is only valid with at least one entry, so it is built here and passed to
// the layout rather than emitted unconditionally.
const faqSchema = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : undefined;
---

<Base
  title={page.page_title}
  description={page.meta_description}
  schema={faqSchema}
>
  <div class="page-header page-header-image">
    <div class="container">
      <h1>Mineral Owners</h1>
      <p>{page.page_subtitle}</p>
    </div>
  </div>

  <section>
    <div class="container container-narrow">
      <div class="prose owner-intro" set:html={introHtml} />

      {page.service_area_line && (
        <p class="service-area-line">{page.service_area_line}</p>
      )}
    </div>
  </section>

  {page.services?.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{page.services_label}</span>
          <h2>{page.services_headline}</h2>
        </div>
        <ul class="owner-services" role="list">
          {page.services.map((s) => (
            <li class="owner-service">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {page.reasons_to_call && (
    <section class="section-alt" aria-labelledby="reasons-headline">
      <div class="container container-narrow">
        <div class="section-header">
          <h2 id="reasons-headline">Common reasons people call us</h2>
          <p>{page.reasons_to_call.intro}</p>
        </div>
        <ul class="reasons-list" role="list">
          {page.reasons_to_call.items.map((r) => (
            <li class="reason">{r.text}</li>
          ))}
        </ul>
        <p class="reasons-closing">{page.reasons_to_call.closing}</p>
        <div class="reasons-actions">
          <a href="/contact" class="btn btn-primary">
            {page.reasons_to_call.button} <span aria-hidden="true">→</span>
          </a>
          {settings.phone && (
            <a href={telHref} class="inline-phone" aria-label={`Call ${settings.phone}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
              {settings.phone}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {page.lease_packet && (
    <section aria-labelledby="lease-packet-headline">
      <div class="container container-narrow">
        <div class="section-header">
          <span class="section-label">{page.lease_packet.label}</span>
          <h2 id="lease-packet-headline">{page.lease_packet.headline}</h2>
          <p>{page.lease_packet.intro}</p>
        </div>

        <ol class="lease-docs" role="list">
          {page.lease_packet.documents.map((doc) => (
            <li class="lease-doc">
              <h3 class="lease-doc-title">{doc.title}</h3>
              <p class="lease-doc-text">{doc.text}</p>
            </li>
          ))}
        </ol>

        <h3 class="lease-terms-headline">{page.lease_packet.terms_headline}</h3>
        <dl class="lease-terms">
          {page.lease_packet.terms.map((t) => (
            <div class="lease-term">
              <dt>{t.title}</dt>
              <dd>{t.text}</dd>
            </div>
          ))}
        </dl>

        <p class="lease-closing">{page.lease_packet.closing}</p>

      </div>
    </section>
  )}

  {page.how_it_works && (
    <HowItWorks headline={page.how_it_works.headline} steps={page.how_it_works.steps} />
  )}

  {page.sample_feature && (
    <SampleFeature
      label={page.sample_feature.label}
      headline={page.sample_feature.headline}
      text={page.sample_feature.text}
      button={page.sample_feature.button}
      tone="alt"
    />
  )}

  {faq.length > 0 && (
    <section>
      <div class="container container-narrow">
        <div class="section-header">
          <span class="section-label">{page.faq_label}</span>
          <h2>{page.faq_headline}</h2>
        </div>
        <dl class="owner-faq">
          {faq.map((f) => (
            <div class="owner-faq-item">
              <dt>{f.question}</dt>
              <dd>{f.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {pennsylvaniaHtml && (
    <section class="section-alt">
      <div class="container container-narrow">
        <h2 class="owner-state-headline">{page.pennsylvania_headline}</h2>
        <div class="prose owner-state-note" set:html={pennsylvaniaHtml} />
      </div>
    </section>
  )}

  {(page.conflict_note || page.disclaimer) && (
    <section class="owner-disclaimer-band">
      <div class="container container-narrow">
        {page.conflict_note && <p class="owner-disclaimer">{page.conflict_note}</p>}
        {page.disclaimer && <p class="owner-disclaimer">{page.disclaimer}</p>}
      </div>
    </section>
  )}

  <CallToAction
    headline={page.cta.headline}
    text={page.cta.text}
    button={page.cta.button}
    tone="light"
  />
</Base>
