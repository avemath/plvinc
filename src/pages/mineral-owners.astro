---
import Base from '../layouts/Base.astro';
import { text } from '../utils/labels';
import CallToAction from '../components/CallToAction.astro';
import SampleFeature from '../components/SampleFeature.astro';
import TrustBand from '../components/TrustBand.astro';
import Disclosures from '../components/Disclosures.astro';
import ReceivedGuide from '../components/ReceivedGuide.astro';
import { renderMarkdown } from '../utils/markdown';
import { cssUrl } from '../utils/cssUrl';
import { needsTint } from '../utils/images';
import page from '../data/pages/mineral-owners.json';
import settings from '../data/settings.json';
import { telHref } from '../utils/phone';

const introHtml = await renderMarkdown(page.intro);
const pennsylvaniaHtml = page.pennsylvania_note
  ? await renderMarkdown(page.pennsylvania_note)
  : '';

const faq = (page.faq || []).filter((f) => f.question && f.answer);

// Each question gets its own address (/mineral-owners#what-is-a-division-order) so it can
// be linked to directly from elsewhere on the site or in an email.
function faqId(q: string) {
  return q.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
}

// The header photo is set in the editor. With none set, the band is the patterned green of the
// other pages.
const headerImage = page.header_image || '';

const tel = telHref(settings.phone);

// The facts that used to sit in the At a glance card, now one row under the opening.
const facts = (page.glance?.items ?? []).filter((i) => i?.title?.trim());

// The row of jump links under the green band. Each link only shows when its section does.
const jump = page.jump_links ?? {};
const leaseDocs = page.lease_packet?.documents ?? [];
const leaseTerms = page.lease_packet?.terms ?? [];
const pennsylvaniaShown = Boolean(pennsylvaniaHtml);
const guide = (page as any).received_guide;
const guideShown = Boolean(guide?.choices?.length);
const jumpLinks = [
  { href: '#what-you-received', label: text((jump as any).guide, 'What you received'), show: guideShown },
  { href: '#lease-offers', label: text(jump.lease, 'Lease offers'), show: Boolean(page.lease_packet) },
  { href: '#key-terms', label: text(jump.terms, 'Key terms'), show: leaseTerms.length > 0 },
  { href: '#pennsylvania', label: text(jump.pennsylvania, 'Pennsylvania'), show: pennsylvaniaShown },
  { href: '#faq', label: text(jump.faq, 'FAQ'), show: faq.length > 0 },
].filter((l) => l.show);


// FAQPage markup is only valid with at least one entry, so it is built here and passed to
// the layout rather than emitted unconditionally.
const faqSchema = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : undefined;
---

<Base
  enhance
  title={page.page_title}
  description={page.meta_description}
  schema={faqSchema}
  preloadImage={headerImage || undefined}
>
  <div
    class:list={['page-header', headerImage && 'page-header-image', needsTint(headerImage) && 'has-tint']}
    style={headerImage ? `--header-image: ${cssUrl(headerImage)}` : undefined}
  >
    <div class="container">
      <h1>{text(page.page_heading, 'Mineral Owners')}</h1>
      <p>{page.page_subtitle}</p>
      {/* The first thing a worried owner may want is a person. Desktop showed no way to
          reach one until well down the page. */}
      <div class="page-header-actions">
        {settings.phone && (
          <a href={tel} class="btn btn-white">{text(page.header_call_label, 'Call')} {settings.phone}</a>
        )}
        <a href="/contact#note" class="btn btn-hero-outline">{text(page.header_note_label, 'Send us the letter')} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  {jumpLinks.length > 0 && (
    <nav class="jump-row" aria-labelledby="jump-row-label">
      <div class="container jump-row-inner">
        <span class="jump-row-label" id="jump-row-label">{text(jump.label, 'On this page')}</span>
        <ul class="jump-row-list" role="list">
          {jumpLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
  )}

  {/* A short opening and the facts in one row, so the page gets to the owner's own
      situation within the first screen or two. */}
  <section class="owner-opening">
    <div class="container container-narrow">
      <div class="prose owner-intro" set:html={introHtml} />
      {facts.length > 0 && (
        <ul class="owner-facts" role="list" aria-label={text(page.glance?.heading, 'At a glance')}>
          {facts.map((f) => (
            <li class="owner-fact">
              <span class="owner-fact-title">{f.title}</span>
              {f.text && <span class="owner-fact-text">{f.text}</span>}
            </li>
          ))}
        </ul>
      )}
      {page.service_area_line && (
        <p class="service-area-line">{page.service_area_line}</p>
      )}
    </div>
  </section>

  {/* The situations people call about are now the guide's choices. The old Reasons to
      Call list (Studio: Common Reasons People Call) is kept in the data but not shown; its
      sentences live on inside the guide. */}
  {guideShown && <ReceivedGuide guide={guide} />}

  {page.lease_packet && (
    <section id="lease-offers" class="owner-lease" aria-labelledby="lease-packet-headline">
      <div class="container container-narrow">
        <div class="section-header is-left">
          <span class="section-label">{page.lease_packet.label}</span>
          <h2 id="lease-packet-headline">{page.lease_packet.headline}</h2>
          {page.lease_packet.intro && <p>{page.lease_packet.intro}</p>}
        </div>

        {leaseDocs.length > 0 && (
          <ol class="lease-docs lease-docs-grid" role="list">
            {leaseDocs.map((doc) => (
              <li class="lease-doc">
                <h3 class="lease-doc-title">{doc.title}</h3>
                <p class="lease-doc-text">{doc.text}</p>
              </li>
            ))}
          </ol>
        )}

        {leaseTerms.length > 0 && (
          <div id="key-terms" class="owner-terms">
            <h3 class="owner-terms-headline">{page.lease_packet.terms_headline}</h3>
            <Disclosures items={leaseTerms.map((t) => ({ title: t.title, text: t.text }))} />
          </div>
        )}

        {page.lease_packet.closing && (
          <div class="owner-lease-cta">
            <p>{page.lease_packet.closing}</p>
            <a href="/contact#note" class="btn btn-primary">
              {text(page.lease_packet.button, 'Send us the offer')} <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  {page.services?.length > 0 && (
    <section class="section-alt owner-bring">
      <div class="container">
        <div class="section-header is-left">
          <span class="section-label">{page.services_label}</span>
          <h2>{page.services_headline}</h2>
        </div>
        <ul class="owner-services" role="list">
          {page.services.map((s) => (
            <li class="owner-service">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {pennsylvaniaShown && (
    <section id="pennsylvania" class="owner-state" aria-labelledby="pennsylvania-headline">
      <div class="container container-narrow">
        <div class="owner-state-card">
          {page.pennsylvania_headline && <h2 id="pennsylvania-headline" class="owner-state-headline">{page.pennsylvania_headline}</h2>}
          <div class="prose owner-state-note" set:html={pennsylvaniaHtml} />
        </div>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section id="faq" class="section-alt owner-faq-section" aria-labelledby="faq-headline">
      <div class="container container-narrow">
        <div class="section-header is-left">
          <span class="section-label">{page.faq_label}</span>
          <h2 id="faq-headline">{page.faq_headline}</h2>
        </div>
        <Disclosures items={faq.map((f) => ({ id: faqId(f.question), title: f.question, text: f.answer }))} />
      </div>
    </section>
  )}

  {/* The trust content a visitor from Google may need, kept but compact: who they will
      talk to, what happens after they call, the sample file, and the two notes. */}
  <TrustBand
    team={{ headline: page.team_headline, intro: page.team_intro, link: page.team_link }}
    steps={page.how_it_works}
    sample={page.sample_feature}
  >
    {(page.conflict_note || page.disclaimer) && (
      <div class="trust-notes">
        {page.conflict_note && <p>{page.conflict_note}</p>}
        {page.disclaimer && <p>{page.disclaimer}</p>}
      </div>
    )}
  </TrustBand>

  <CallToAction
    headline={page.cta.headline}
    text={page.cta.text}
    button={page.cta.button}
    href="/contact#note"
    tone="light"
    phone={settings.phone}
    phoneHref={tel}
  />
</Base>
