---
import Base from '../layouts/Base.astro';
import { text } from '../utils/labels';
import ServiceList from '../components/ServiceList.astro';
import CoverageMap from '../components/CoverageMap.astro';
import CallToAction from '../components/CallToAction.astro';
import SampleFeature from '../components/SampleFeature.astro';
import TeamStrip from '../components/TeamStrip.astro';
import StepsStrip from '../components/StepsStrip.astro';
import PriceTicker from '../components/PriceTicker.astro';
import MemberMarks from '../components/MemberMarks.astro';
import contact from '../data/pages/contact.json';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import sharp from 'sharp';
import { cssUrl } from '../utils/cssUrl';
import home from '../data/pages/home.json';
import settings from '../data/settings.json';
import { telHref } from '../utils/phone';

const services = await getCollection('services');
const sorted   = [...services].sort((a, b) => a.data.sort_order - b.data.sort_order);
// The figures under the hero, as one slim strip: the figure and its label. The longer
// "what it means" line stays in the editor but is not shown here.
const stats = (home.stats ?? []).filter((s) => s?.value?.trim());

const tel = telHref(settings.phone);

// The registered name leads the hero. Falls back to the trading name so the hero
// never renders a blank line if legal_name is cleared in Site Settings.
const heroName = settings.legal_name || settings.professional_name;

// The AAPL member marks. The band stays hidden until at least one file is uploaded.
const membership = home.membership ?? {};
const memberMarks = [
  { src: membership.member_mark, alt: membership.member_mark_alt },
  { src: membership.cpl_mark, alt: membership.cpl_mark_alt },
];
const hasMemberMarks = memberMarks.some((m) => m.src?.trim());

// The AAPL member mark closes the strip once it has been uploaded, but only while the AAPL
// band further down is not on the page, so the mark never appears twice on Home. The band
// decides for itself when it shows (hasMemberMarks, unchanged); the strip just follows it.
// Shown as supplied, at its own proportions; its size is read from the file so nothing
// moves as it loads.
const membershipBandShown = hasMemberMarks;
const stripMarkSrc = membershipBandShown ? '' : membership.member_mark?.trim() || '';
let stripMark: { src: string; alt: string; width?: number; height?: number } | undefined;
if (stripMarkSrc) {
  stripMark = { src: stripMarkSrc, alt: membership.member_mark_alt?.trim() || '' };
  try {
    const file = `public${decodeURI(stripMarkSrc)}`;
    if (fs.existsSync(file)) {
      const meta = await sharp(file).metadata();
      if (meta.width && meta.height) Object.assign(stripMark, { width: meta.width, height: meta.height });
    }
  } catch {}
}
---

<Base
  title={settings.seo_title}
  description={settings.seo_description}
  image={settings.seo_share_image}
  preloadImage={home.hero_image || undefined}
>
  <!-- ─── Hero ─── -->
  <section
    class:list={['hero', home.hero_image && 'hero-image']}
    style={home.hero_image ? `--hero-image: ${cssUrl(home.hero_image)}` : undefined}
    aria-label="Introduction"
  >
    <div class="hero-content">
      <div class="hero-inner">
        <h1>
          <span class="hero-name">{heroName}</span>
          {home.hero_headline}
        </h1>
        <p class="hero-sub">{home.hero_subheadline}</p>
        <!-- Two paths, because the two audiences arrive with different questions. -->
        <div class="hero-paths">
          <a href={home.hero_cta_href || '/mineral-owners'} class="btn btn-white">
            {home.hero_cta_text} <span aria-hidden="true">→</span>
          </a>
          {home.hero_secondary_cta_text && (
            <a href={home.hero_secondary_cta_href || '/contact'} class="btn btn-hero-outline">
              {home.hero_secondary_cta_text} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>

        {settings.phone && (
          <p class="hero-phone">
            <a href={tel} aria-label={`Call ${settings.phone}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
              {settings.phone}
            </a>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ─── Credential strip: the three figures, and the AAPL mark once uploaded ─── -->
  {stats.length > 0 && (
    <section class="cred-strip" aria-label="At a glance">
      <div class="container">
        <ul class:list={['cred-list', stripMark && 'has-mark']} role="list">
          {stats.map((s) => (
            <li class="cred">
              <span class="stat-value cred-value">{s.value}</span>
              <span class="cred-label">{s.label}</span>
            </li>
          ))}
          {stripMark && (
            <li class="cred-mark">
              <img src={stripMark.src} alt={stripMark.alt} width={stripMark.width} height={stripMark.height} decoding="async" />
            </li>
          )}
        </ul>
      </div>
    </section>
  )}

  <!-- ─── Oil and gas prices, switched on and off in the editor ─── -->
  {home.price_ticker?.show && home.price_ticker.symbols?.length > 0 && (
    <PriceTicker label={home.price_ticker.label} symbols={home.price_ticker.symbols} />
  )}

  <!-- ─── Who you'll talk to ─── -->
  <TeamStrip
    label={home.team_label}
    headline={home.team_headline}
    intro={home.team_intro}
    link={home.team_link}
  />

  <!-- ─── AAPL membership, hidden until a member mark is uploaded ─── -->
  {hasMemberMarks && (
    <section class="affiliations-band membership-band">
      <div class="container container-narrow">
        <MemberMarks marks={memberMarks} />
        {membership.text && <p class="membership-text">{membership.text}</p>}
      </div>
    </section>
  )}

  <!-- ─── Sample file ─── -->
  {home.sample_feature?.headline && (
    <SampleFeature
      label={home.sample_feature.label}
      headline={home.sample_feature.headline}
      text={home.sample_feature.text}
      button={home.sample_feature.button}
      tone="alt"
    />
  )}

  <!-- ─── Services overview ─── -->
  <section class="home-services">
    <div class="container">
      <div class="section-header-row">
        <div class="section-header is-left">
          <span class="section-label">{home.services_label}</span>
          <h2>{home.services_headline}</h2>
          <p>{home.services_intro}</p>
        </div>
        <p class="section-aside">
          <a href="/services">{text(home.services_link_text, 'See what each service covers')} <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <ServiceList
        services={sorted.map((svc) => ({
          title: svc.data.title,
          icon: svc.data.icon,
          slug: svc.id,
          summary: svc.data.card_description,
        }))}
      />
    </div>
  </section>

  <!-- ─── Testimonials, hidden until at least one is added ─── -->
  {home.testimonials?.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{home.testimonials_label}</span>
          <h2>{home.testimonials_headline}</h2>
        </div>
        <div class="testimonials-grid">
          {home.testimonials.map((t) => (
            <figure class="testimonial-card">
              <blockquote>
                <p class="testimonial-quote">{t.quote}</p>
              </blockquote>
              {t.attribution && (
                <figcaption>
                  <span class="testimonial-title">{t.attribution}</span>
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── What happens when you get in touch: the Contact page's steps, as one compact row ─── -->
  {contact.how_it_works?.headline && (
    <section class="steps-band" aria-labelledby="steps-band-headline">
      <div class="container">
        <StepsStrip headline={contact.how_it_works.headline} steps={contact.how_it_works.steps} headingId="steps-band-headline" />
      </div>
    </section>
  )}

  <!-- ─── Coverage map ─── -->
  <CoverageMap />

  <!-- ─── Closing CTA ─── -->
  <CallToAction
    headline={home.cta.headline}
    text={home.cta.text}
    button={home.cta.button}
    image={home.cta.image}
    phone={settings.phone}
    phoneHref={tel}
  />
</Base>
