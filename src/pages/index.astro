---
import Base from '../layouts/Base.astro';
import ServiceList from '../components/ServiceList.astro';
import CoverageMap from '../components/CoverageMap.astro';
import CallToAction from '../components/CallToAction.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';
import { cssUrl } from '../utils/cssUrl';
import home from '../data/pages/home.json';
import settings from '../data/settings.json';

const services = await getCollection('services');
const sorted   = [...services].sort((a, b) => a.data.sort_order - b.data.sort_order);
const valueParagraphHtml = await renderMarkdown(home.value_paragraph);
---

<Base
  title={settings.seo_title}
  description={settings.seo_description}
  image={settings.seo_share_image}
>
  <!-- ─── Hero ─── -->
  <section
    class:list={['hero', home.hero_image && 'hero-image']}
    style={home.hero_image ? `--hero-image: ${cssUrl(home.hero_image)}` : undefined}
    aria-label="Introduction"
  >
    <div class="hero-content">
      <div class="hero-inner">
        <h1>{home.hero_headline}</h1>
        <p class="hero-sub">{home.hero_subheadline}</p>
        <a href="/contact" class="btn btn-white">
          {home.hero_cta_text} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Proof points ─── -->
  {home.stats?.length > 0 && (
    <section class="stat-row" aria-label="At a glance">
      <div class="container">
        <ul class="stat-row-list" role="list">
          {home.stats.map((s) => (
            <li class="stat">
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ─── Value paragraph ─── -->
  <section class="value-section">
    <div class="container">
      <div class="value-text prose" set:html={valueParagraphHtml} />
    </div>
  </section>

  <!-- ─── Coverage map ─── -->
  <CoverageMap />

  <!-- ─── Services overview ─── -->
  <section>
    <div class="container">
      <div class="section-header">
        <span class="section-label">{home.services_label}</span>
        <h2>{home.services_headline}</h2>
        <p>{home.services_intro}</p>
      </div>
      <ServiceList
        services={sorted.map((svc) => ({
          title: svc.data.title,
          card_description: svc.data.card_description,
          icon: svc.data.icon,
          slug: svc.id,
        }))}
      />

      <p class="section-aside">
        <a href="/services">See what each service covers →</a>
      </p>
    </div>
  </section>

  <!-- ─── Testimonials — hidden until at least one is added ─── -->
  {home.testimonials?.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">{home.testimonials_label}</span>
          <h2>{home.testimonials_headline}</h2>
        </div>
        <div class="testimonials-grid">
          {home.testimonials.map((t) => (
            <figure class="testimonial-card">
              <blockquote>
                <p class="testimonial-quote">{t.quote}</p>
              </blockquote>
              {t.attribution && (
                <figcaption>
                  <span class="testimonial-title">{t.attribution}</span>
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── Closing CTA ─── -->
  <CallToAction
    headline={home.cta.headline}
    text={home.cta.text}
    button={home.cta.button}
    image={home.cta.image}
  />
</Base>
