---
// The company counterpart to Mineral Owners. The order puts what a land manager checks
// first near the top: what we take on, the hard files, and the answers to their questions.
// Trust content (team, steps, sample file, states) sits in one compact band at the foot. Copy lives in
// src/data/pages/companies.json; the services and the states come from their own sources
// so this page can never disagree with the Services or Experience pages.
import Base from '../layouts/Base.astro';
import { text } from '../utils/labels';
import CallToAction from '../components/CallToAction.astro';
import TrustBand from '../components/TrustBand.astro';
import Disclosures from '../components/Disclosures.astro';
import HardFilesShort from '../components/HardFilesShort.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../utils/markdown';
import { cssUrl } from '../utils/cssUrl';
import { needsTint } from '../utils/images';
import page from '../data/pages/companies.json';
import experience from '../data/pages/experience.json';
import settings from '../data/settings.json';
import { telHref } from '../utils/phone';

const introHtml = page.intro ? await renderMarkdown(page.intro) : '';
const statesAsideHtml = page.states_aside ? await renderMarkdown(page.states_aside) : '';

const services = [...(await getCollection('services'))].sort((a, b) => a.data.sort_order - b.data.sort_order);
const states = (experience.states_served || []).filter((s) => s.state);
const standards = (page.standards || []).filter((s) => s.title);
const faq = (page.faq || []).filter((f) => f.question && f.answer);
const facts = (page.glance?.items ?? []).filter((i) => i?.title?.trim());

// "Pennsylvania, Ohio and Texas": the states from the Experience page, as one line.
const stateNames = states.map((s) => s.state);
const stateList = stateNames.length > 1
  ? `${stateNames.slice(0, -1).join(', ')} and ${stateNames[stateNames.length - 1]}`
  : stateNames.join('');

function faqId(q: string) {
  return q.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
}

const headerImage = page.header_image || '';
const tel = telHref(settings.phone);

const faqSchema = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : undefined;
---

<Base
  title={page.page_title}
  description={page.meta_description}
  schema={faqSchema}
  preloadImage={headerImage || undefined}
>
  <div
    class:list={['page-header', headerImage && 'page-header-image', needsTint(headerImage) && 'has-tint']}
    style={headerImage ? `--header-image: ${cssUrl(headerImage)}` : undefined}
  >
    <div class="container">
      <h1>{text(page.page_heading, 'For Companies')}</h1>
      <p>{page.page_subtitle}</p>
      <div class="page-header-actions">
        {settings.phone && (
          <a href={tel} class="btn btn-white">{text(page.header_call_label, 'Call')} {settings.phone}</a>
        )}
        <a href="/contact#project" class="btn btn-hero-outline">{text(page.header_project_label, 'Tell us about the project')} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  {(introHtml || facts.length > 0) && (
    <section class="owner-opening">
      <div class="container container-narrow">
        {introHtml && <div class="prose owner-intro" set:html={introHtml} />}
        {facts.length > 0 && (
          <ul class="owner-facts" role="list" aria-label={text(page.glance?.heading, 'At a glance')}>
            {facts.map((f) => (
              <li class="owner-fact">
                <span class="owner-fact-title">{f.title}</span>
                {f.text && <span class="owner-fact-text">{f.text}</span>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <HardFilesShort
    label={page.hard_files_short?.label}
    headline={page.hard_files_short?.headline}
    intro={page.hard_files_short?.intro}
    link={page.hard_files_short?.link}
  />

  {services.length > 0 && (
    <section class="section-alt">
      <div class="container">
        <div class="section-header">
          {page.services_label && <span class="section-label">{page.services_label}</span>}
          <h2>{text(page.services_headline, 'What We Handle')}</h2>
          {page.services_intro && <p>{page.services_intro}</p>}
        </div>
        <div class="services-grid">
          {services.map((svc) => (
            <ServiceCard
              title={svc.data.title}
              card_description={svc.data.card_description}
              icon={svc.data.icon}
              slug={svc.id}
              level={3}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section id="faq" class="owner-faq-section" aria-labelledby="faq-headline">
      <div class="container container-narrow">
        <div class="section-header is-left">
          {page.faq_label && <span class="section-label">{page.faq_label}</span>}
          <h2 id="faq-headline">{page.faq_headline}</h2>
        </div>
        <Disclosures items={faq.map((f) => ({ id: faqId(f.question), title: f.question, text: f.answer }))} />
        {page.faq_cta?.text && (
          <div class="owner-lease-cta">
            <p>{page.faq_cta.text}</p>
            <a href="/contact#project" class="btn btn-primary">
              {text(page.faq_cta.button, 'Tell us about the project')} <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  {standards.length > 0 && (
    <section class="section-alt section-roomy">
      <div class="container section-split">
        <div class="section-header is-left">
          {page.standards_label && <span class="section-label">{page.standards_label}</span>}
          <h2>{page.standards_headline}</h2>
        </div>
        <ul class="owner-services is-stacked" role="list">
          {standards.map((s) => (
            <li class="owner-service">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <TrustBand
    label="Working with us"
    team={{ headline: page.team_headline, intro: page.team_intro, link: page.team_link }}
    steps={page.how_it_works}
    sample={page.sample_feature}
  >
    {stateList && (
      <div class="trust-sample trust-states">
        <strong>{text(page.states_headline, "Where We've Worked")}.</strong>{' '}
        {stateList}.{' '}
        {statesAsideHtml && <span class="trust-inline" set:html={statesAsideHtml} />}
      </div>
    )}
  </TrustBand>

  <CallToAction
    headline={page.cta.headline}
    text={page.cta.text}
    button={page.cta.button}
    href="/contact#project"
    tone="light"
    phone={settings.phone}
    phoneHref={tel}
  />
</Base>
