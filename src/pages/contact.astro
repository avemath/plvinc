---
import Base from '../layouts/Base.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CallToAction from '../components/CallToAction.astro';
import ContactForm from '../components/ContactForm.astro';
import contact from '../data/pages/contact.json';
import settings from '../data/settings.json';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { getLinkedInProfiles } from '../utils/people';

const profiles = await getLinkedInProfiles();

// Same rule as the footer: based_in first, then city and state if that is how it was filled in.
const location = settings.based_in
  || (settings.city && settings.state ? `${settings.city}, ${settings.state}` : '');

const ctaTelHref = settings.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : '/contact';
---

<Base
  title={contact.page_title}
  description={contact.meta_description}
>
  <div class="page-header">
    <div class="container">
      <h1>Contact</h1>
      <p>{contact.intro}</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="contact-grid">

        <!-- Contact details -->
        <div>
          <h2>{contact.details_headline}</h2>
          <div class="contact-details">
            {/* Phone and email come from Site Settings, so changing them there updates
                this page, the header, the footer and the call buttons together. */}
            {settings.phone && (
              <div>
                <span class="contact-detail-label">Phone</span>
                <a
                  href={ctaTelHref}
                  class="contact-detail-value"
                  aria-label={`Call ${settings.phone}`}
                >
                  {settings.phone}
                </a>
              </div>
            )}

            {settings.email && (
              <div>
                <span class="contact-detail-label">Email</span>
                <a
                  href={`mailto:${settings.email}`}
                  class="contact-detail-value"
                >
                  {settings.email}
                </a>
              </div>
            )}

            {location && (
              <div>
                <span class="contact-detail-label">Based In</span>
                <address class="contact-detail-value contact-address">{location}</address>
              </div>
            )}

            {settings.linkedin_url && (
              <div>
                <span class="contact-detail-label">LinkedIn</span>
                <a
                  href={settings.linkedin_url}
                  class="contact-detail-value"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {settings.professional_name} on LinkedIn
                </a>
              </div>
            )}

            {profiles.length > 0 && (
              <div>
                <span class="contact-detail-label">LinkedIn</span>
                <ul class="contact-linkedin-list" role="list">
                  {profiles.map((p) => (
                    <li>
                      <a
                        href={p.url}
                        class="contact-detail-value contact-linkedin"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${p.name} on LinkedIn (opens in a new tab)`}
                      >
                        <LinkedInIcon size={18} />
                        <span>{p.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {contact.service_area_note && (
              <div>
                <span class="contact-detail-label">Service Area</span>
                <span class="contact-detail-value">{contact.service_area_note}</span>
              </div>
            )}

            {contact.mailing_address && (
              <div>
                <span class="contact-detail-label">Mailing Address</span>
                <address class="contact-detail-value contact-address">
                  {contact.mailing_address}
                </address>
              </div>
            )}
          </div>
        </div>

        <!-- Form -->
        <ContactForm />
      </div>
    </div>
  </section>
  {contact.how_it_works && (
    <HowItWorks
      headline={contact.how_it_works.headline}
      steps={contact.how_it_works.steps}
      tone="alt"
    />
  )}

  {contact.cta && (
    <CallToAction
      headline={contact.cta.headline}
      text={contact.cta.text}
      button={contact.cta.button}
      href={ctaTelHref}
      phone={settings.phone}
      phoneHref={ctaTelHref}
    />
  )}
</Base>
