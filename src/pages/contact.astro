---
import Base from '../layouts/Base.astro';
import { text } from '../utils/labels';
import HowItWorks from '../components/HowItWorks.astro';
import CallToAction from '../components/CallToAction.astro';
import ContactForm from '../components/ContactForm.astro';
import contact from '../data/pages/contact.json';
import settings from '../data/settings.json';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { getLinkedInProfiles } from '../utils/people';
import { telHref } from '../utils/phone';

const profiles = await getLinkedInProfiles();

// The small grey labels above each contact detail. Blank ones keep their original wording.
const dl = (contact as { detail_labels?: Record<string, string> }).detail_labels ?? {};
const label = {
  phone: text(dl.phone, 'Phone'),
  email: text(dl.email, 'Email'),
  based_in: text(dl.based_in, 'Based In'),
  linkedin: text(dl.linkedin, 'LinkedIn'),
  service_area: text(dl.service_area, 'Service Area'),
  mailing_address: text(dl.mailing_address, 'Mailing Address'),
};

// Same rule as the footer: based_in first, then city and state if that is how it was filled in.
const location = settings.based_in
  || (settings.city && settings.state ? `${settings.city}, ${settings.state}` : '');

---

<Base
  title={contact.page_title}
  description={contact.meta_description}
>
  <div class="page-header">
    <div class="container">
      <h1>{text(contact.page_heading, 'Contact')}</h1>
      <p>{contact.intro}</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="contact-grid">

        {/* Phone and email first, then the form, then the rest. On a wide screen the details
            stack on the left of the form; on a phone the form now comes straight after the
            phone and email instead of after a full screen of LinkedIn and service area. */}
        <div class="contact-primary">
          <h2>{contact.details_headline}</h2>
          <div class="contact-details">
            {/* Phone and email come from Site Settings, so changing them there updates
                this page, the header, the footer and the call buttons together. */}
            {settings.phone && (
              <div>
                <span class="contact-detail-label">{label.phone}</span>
                <a
                  href={telHref(settings.phone)}
                  class="contact-detail-value"
                  aria-label={`Call ${settings.phone}`}
                >
                  {settings.phone}
                </a>
              </div>
            )}

            {settings.email && (
              <div>
                <span class="contact-detail-label">{label.email}</span>
                <a
                  href={`mailto:${settings.email}`}
                  class="contact-detail-value"
                >
                  {settings.email}
                </a>
              </div>
            )}

          </div>
        </div>

        <div class="contact-form-area">
          <ContactForm />
        </div>

        <div class="contact-more">
          <div class="contact-details">
            {location && (
              <div>
                <span class="contact-detail-label">{label.based_in}</span>
                <address class="contact-detail-value contact-address">{location}</address>
              </div>
            )}

            {settings.linkedin_url && (
              <div>
                <span class="contact-detail-label">{label.linkedin}</span>
                <a
                  href={settings.linkedin_url}
                  class="contact-detail-value"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {settings.professional_name} on LinkedIn
                </a>
              </div>
            )}

            {profiles.length > 0 && (
              <div>
                <span class="contact-detail-label">{label.linkedin}</span>
                <ul class="contact-linkedin-list" role="list">
                  {profiles.map((p) => (
                    <li>
                      <a
                        href={p.url}
                        class="contact-detail-value contact-linkedin"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${p.name} on LinkedIn (opens in a new tab)`}
                      >
                        <LinkedInIcon size={18} />
                        <span>{p.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {contact.service_area_note && (
              <div>
                <span class="contact-detail-label">{label.service_area}</span>
                <span class="contact-detail-value">{contact.service_area_note}</span>
              </div>
            )}

            {contact.mailing_address && (
              <div>
                <span class="contact-detail-label">{label.mailing_address}</span>
                <address class="contact-detail-value contact-address">
                  {contact.mailing_address}
                </address>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
  {contact.how_it_works && (
    <HowItWorks
      label={contact.how_it_works.label}
      headline={contact.how_it_works.headline}
      steps={contact.how_it_works.steps}
      tone="alt"
    />
  )}

  {/* The button already dials the number, so the band does not repeat it beside the
      button, and there is no band at all without a phone to call. */}
  {contact.cta?.headline && settings.phone && (
    <CallToAction
      headline={contact.cta.headline}
      text={contact.cta.text}
      button={contact.cta.button}
      href={telHref(settings.phone)}
    />
  )}
</Base>
