---
import Base from '../../layouts/Base.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import SampleFeature from '../../components/SampleFeature.astro';
import servicesPage from '../../data/pages/services.json';
import { getCollection, render } from 'astro:content';
import settings from '../../data/settings.json';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry }       = Astro.props;
const { Content }     = await render(entry);
const { title, icon, show_sample_link } = entry.data;
---

<Base
  title={entry.data.seo_title || `${title} | ${settings.professional_name}`}
  description={entry.data.seo_description || entry.data.card_description}
>
  <!-- Header -->
  <div class="service-detail-header">
    <div class="container">
      {icon && (
        <div class="service-detail-icon">
          <ServiceIcon name={icon} size={48} class="service-detail-svg" />
        </div>
      )}
      <h1>{title}</h1>
    </div>
  </div>

  <!-- Body -->
  <section class="service-detail-body">
    <div class="container">
      <div class="prose">
        <Content />
      </div>

      <div class="service-nav">
        <a href="/services" class="back-link">
          <span aria-hidden="true">←</span> All Services
        </a>
        <a href="/contact" class="btn btn-primary">Discuss This Service →</a>
      </div>
    </div>
  </section>

  {show_sample_link && servicesPage.sample_feature && (
    <SampleFeature
      label={servicesPage.sample_feature.label}
      headline={servicesPage.sample_feature.headline}
      text={servicesPage.sample_feature.text}
      button={servicesPage.sample_feature.button}
      tone="alt"
    />
  )}
</Base>
