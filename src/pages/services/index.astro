---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { getCollection } from 'astro:content';
import page from '../../data/pages/services.json';
import settings from '../../data/settings.json';

const services = await getCollection('services');
const sorted   = [...services].sort((a, b) => a.data.sort_order - b.data.sort_order);
---

<Base
  title={`Services — ${settings.professional_name}`}
  description={page.meta_description}
>
  <div class="page-header">
    <div class="container">
      <h1>Services</h1>
      <p>{page.page_subtitle}</p>
    </div>
  </div>

  <section class="section-alt">
    <div class="container">
      <div class="services-grid">
        {sorted.map((svc) => (
          <ServiceCard
            title={svc.data.title}
            card_description={svc.data.card_description}
            icon={svc.data.icon}
            slug={svc.id}
          />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    headline={page.cta.headline}
    text={page.cta.text}
    button={page.cta.button}
    tone="light"
  />
</Base>
