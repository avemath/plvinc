---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import settings from '../../data/settings.json';

const services = await getCollection('services');
const sorted   = [...services].sort((a, b) => a.data.sort_order - b.data.sort_order);
---

<Base
  title={`Services — ${settings.professional_name}`}
  description="Full-service land consulting: title research and curative, lease acquisition, A&D due diligence, mineral and royalty management, right-of-way, and solar and renewable land acquisition."
>
  <div class="page-header">
    <div class="container">
      <h1>Services</h1>
      <p>
        Full-service land consulting across the complete project lifecycle — from
        courthouse research through executed agreements and ongoing portfolio management.
      </p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="services-grid">
        {sorted.map((svc) => (
          <ServiceCard
            title={svc.data.title}
            card_description={svc.data.card_description}
            icon={svc.data.icon}
            slug={svc.id}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Not Sure What You Need?</h2>
      <p>
        Describe the project and we'll talk through how to approach it — no obligation.
      </p>
      <a href="/contact" class="btn btn-white">Get in Touch →</a>
    </div>
  </section>
</Base>
