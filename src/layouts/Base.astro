---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import CountUp from '../components/CountUp.astro';
import SEO from '../components/SEO.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import settings from '../data/settings.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD for this page, passed straight through to SEO. */
  schema?: unknown;
}

const { title, description, image, noindex = false, schema } = Astro.props;

// Fonts are self-hosted (src/styles/fonts.css). They used to come from
// fonts.googleapis.com, which put a render-blocking stylesheet on one third-party origin
// and the font files on a second, each costing a DNS lookup and TLS handshake before any
// text could paint.
//
// The @font-face rules live in the bundled CSS, so a browser only discovers them once
// that stylesheet has parsed. The two preloads below start the latin files immediately
// instead. latin-ext is left to load on demand, and nothing else is shipped.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The droplet from the wordmark. The SVG stays first for browsers that take it;
         the PNGs are rendered from that same SVG and cover everything else, including
         the iOS home screen. The version query is here because browsers hold on to a
         favicon far longer than any cache header asks them to: bump it when the icon
         changes, or people keep seeing the old one. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#1B4332" />
    <link
      rel="preload"
      href="/fonts/inter-latin-SjIa1ZL7.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-IRggexSg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO
      title={title || settings.seo_title}
      description={description || settings.seo_description}
      image={image || settings.seo_share_image || ''}
      siteName={settings.professional_name}
      noindex={noindex}
      schema={schema}
    />
  </head>
  <body>
    <Nav settings={settings} />
    <main id="main-content">
      <slot />
    </main>
    <Footer settings={settings} />
    <StickyContactBar phone={settings.phone} />
    <CountUp />
  </body>

  <script>
    // ── Scroll-reveal with per-row stagger ───────────────────
    // Groups entries by their visual row (same top position) and
    // staggers left-to-right within each row, so every row always
    // animates from the leftmost card regardless of DOM index.
    const obs = new IntersectionObserver(
      (entries) => {
        const rowMap = new Map<number, Element[]>();

        entries
          .filter((e) => e.isIntersecting)
          .forEach((e) => {
            const rowKey = Math.round(e.target.getBoundingClientRect().top / 5) * 5;
            if (!rowMap.has(rowKey)) rowMap.set(rowKey, []);
            rowMap.get(rowKey)!.push(e.target);
          });

        rowMap.forEach((rowEls) => {
          rowEls
            .sort((a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left)
            .forEach((el, col) => {
              (el as HTMLElement).style.transitionDelay = `${col * 0.1}s`;
              el.classList.add('is-visible');
              obs.unobserve(el);
            });
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document
      .querySelectorAll(
        '.state-card, .testimonial-card, .person-card, .credential-item, .approach-section,' +
        '.stat, .hiw-step, .reason, .hard-file, .lease-doc, .how-to-read-card'
      )
      .forEach((el) => { el.classList.add('reveal'); obs.observe(el); });

    // Opacity-only reveal for elements that own a hover transform.
    // The sample preview is deliberately not in here: it is the only thing in
    // its band, so a band that arrives without it reads as broken rather than
    // as animating.
    document
      .querySelectorAll('.service-card, .coverage-map, .coverage-detail, .service-tile')
      .forEach((el) => { el.classList.add('reveal-fade'); obs.observe(el); });

    // ── Nav shadow on scroll ──────────────────────────────────
    const header = document.querySelector('.site-header');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</html>
