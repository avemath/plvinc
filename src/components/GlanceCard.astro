---
// A short "at a glance" card beside a page's opening text: a few plain facts and a call
// button. The facts are typed per page in the editor, so the card says only what the
// owner has put there. With no facts filled in, nothing renders and the intro takes the
// full width.
import { text } from '../utils/labels';
import settings from '../data/settings.json';
import { telHref } from '../utils/phone';

interface Props {
  glance?: {
    heading?: string | null;
    items?: { title?: string | null; text?: string | null }[] | null;
    call_label?: string | null;
  } | null;
}

const { glance } = Astro.props;
const items = (glance?.items ?? []).filter((i) => i?.title?.trim());
const tel = telHref(settings.phone);
---

{items.length > 0 && (
  <aside class="glance-card" aria-labelledby="glance-heading">
    <p class="glance-heading" id="glance-heading">{text(glance?.heading, 'At a glance')}</p>
    <ul class="glance-list" role="list">
      {items.map((i) => (
        <li class="glance-item">
          <span class="glance-title">{i.title}</span>
          {i.text && <span class="glance-text">{i.text}</span>}
        </li>
      ))}
    </ul>
    {settings.phone && (
      <a href={tel} class="btn btn-primary glance-call">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        {text(glance?.call_label, 'Call')} {settings.phone}
      </a>
    )}
  </aside>
)}
