---
import ServiceIcon from './ServiceIcon.astro';

// The home page index of the services.
//
// /services carries the full preview cards, with a description under each title.
// Repeating them here made the two pages read as the same block twice, so the
// home page shows the icon and the name only. Six tiles are scannable at a
// glance and still take you straight to the page that explains the work.
interface Props {
  services: { title: string; icon?: string; slug: string }[];
}

const { services } = Astro.props;
---

<ul class="service-tiles" role="list">
  {services.map((svc) => (
    <li>
      <a href={`/services/${svc.slug}`} class="service-tile">
        {svc.icon && (
          <span class="service-tile-icon" aria-hidden="true">
            <ServiceIcon name={svc.icon} size={28} />
          </span>
        )}
        <span class="service-tile-title">{svc.title}</span>
      </a>
    </li>
  ))}
</ul>
