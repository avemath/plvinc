---
import ServiceIcon from './ServiceIcon.astro';

// The home page index of the services: compact tiles, each one a single link.
//
// The one-line summary under each title is the service's card description, the same
// field the /services cards show, so the two can never disagree. Leave summary out and
// the tile shows the icon and the name only.
interface Props {
  services: { title: string; icon?: string; slug: string; summary?: string | null }[];
}

const { services } = Astro.props;
---

<ul class="service-tiles" role="list">
  {services.map((svc) => (
    <li>
      <a href={`/services/${svc.slug}`} class="service-tile">
        {svc.icon && (
          <span class="service-tile-icon" aria-hidden="true">
            <ServiceIcon name={svc.icon} size={28} />
          </span>
        )}
        <span class="service-tile-body">
          <span class="service-tile-title">{svc.title}</span>
          {svc.summary && <span class="service-tile-summary">{svc.summary}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>
