  name: string | undefined;
  size?: number;
  class?: string;
}

const { name, size = 40, class: className = '' } = Astro.props;

// Heroicons 2.0 outline paths — each entry is one or more SVG <path> d= strings.
const icons: Record<string, string[]> = {
