---
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';
import contact from '../data/pages/contact.json';
import states from '../data/us-states.json';

interface Props {
  recipientEmail?: string;
}

const { recipientEmail } = Astro.props;
const email = recipientEmail || settings.email || '';

// Web3Forms uses each field's name attribute as the label in the email it sends, so the
// new fields are named in plain words rather than in code style. `name`, `email` and
// `message` keep their original names because Web3Forms treats those specially.
const labels = contact.form_labels;
const inquirerTypes = (contact.inquirer_types || []).map((t) => t.label).filter(Boolean);
const timelines = (contact.timelines || []).map((t) => t.label).filter(Boolean);

// The service list comes from the services collection so the form can never offer
// something the site does not describe, or miss one that was added.
let serviceNames: string[] = [];
try {
  const services = await getCollection('services');
  serviceNames = [...services]
    .sort((a, b) => a.data.sort_order - b.data.sort_order)
    .map((s) => s.data.title);
} catch {
  serviceNames = [];
}

// The map data covers the contiguous states, which is the same footprint the site claims.
const stateNames = (states as { name: string }[]).map((s) => s.name);
---

<div class="contact-form-block">
  <h2>{contact.form_headline}</h2>
  {contact.form_intro && <p class="form-intro">{contact.form_intro}</p>}

  <form
    id="contact-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    novalidate
  >
    <input type="hidden" name="access_key"  value={settings.web3forms_key} />
    <input type="hidden" name="subject"     value="New inquiry from website contact form" />
    <input type="hidden" name="redirect"    value="false" />
    {email && <input type="hidden" name="from_name" value={settings.professional_name} />}

    <!-- Honeypot — hidden from people, left unchecked. Web3Forms silently
         rejects any submission where this arrives checked. -->
    <label class="botcheck-field" aria-hidden="true">
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>

    <div class="form-group">
      <label for="contact-name">
        Name <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        placeholder="Your name"
        autocomplete="name"
        required
        aria-describedby="contact-name-error"
      />
      <p class="field-error" id="contact-name-error" hidden></p>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="contact-email">
          Email <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          aria-describedby="contact-email-error"
        />
        <p class="field-error" id="contact-email-error" hidden></p>
      </div>

      <div class="form-group">
        <label for="contact-phone">{labels.phone}</label>
        <input
          type="tel"
          id="contact-phone"
          name="Phone"
          placeholder="(555) 555-5555"
          autocomplete="tel"
        />
      </div>
    </div>

    {inquirerTypes.length > 0 && (
      <div class="form-group">
        <label for="contact-role">
          {labels.inquirer_type} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-role"
          name="I am a"
          required
          aria-describedby="contact-role-error"
        >
          <option value="">Please choose</option>
          {inquirerTypes.map((t) => <option value={t}>{t}</option>)}
        </select>
        <p class="field-error" id="contact-role-error" hidden></p>
      </div>
    )}

    <div class="form-row">
      <div class="form-group">
        <label for="contact-state">
          {labels.state} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-state"
          name="State"
          required
          aria-describedby="contact-state-error"
        >
          <option value="">Please choose</option>
          {stateNames.map((s) => <option value={s}>{s}</option>)}
        </select>
        <p class="field-error" id="contact-state-error" hidden></p>
      </div>

      <div class="form-group">
        <label for="contact-county">
          {labels.county} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="contact-county"
          name="County or parish"
          placeholder="Where the tract sits"
          required
          aria-describedby="contact-county-error"
        />
        <p class="field-error" id="contact-county-error" hidden></p>
      </div>
    </div>

    {serviceNames.length > 0 && (
      <div class="form-group">
        <label for="contact-service">
          {labels.service} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-service"
          name="Service needed"
          required
          aria-describedby="contact-service-error"
        >
          <option value="">Please choose</option>
          {serviceNames.map((s) => <option value={s}>{s}</option>)}
          <option value="Not sure yet">Not sure yet</option>
        </select>
        <p class="field-error" id="contact-service-error" hidden></p>
      </div>
    )}

    {timelines.length > 0 && (
      <div class="form-group">
        <label for="contact-timeline">{labels.timeline}</label>
        <select id="contact-timeline" name="Timeline">
          <option value="">Please choose</option>
          {timelines.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
    )}

    <div class="form-group">
      <label for="contact-message">
        Message <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        placeholder="Tell us about your project…"
        required
        aria-describedby="contact-message-error"
      ></textarea>
      <p class="field-error" id="contact-message-error" hidden></p>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>

    <div id="form-success" class="form-success" role="status" aria-live="polite" hidden>
      <p>Thank you — your message has been sent. We'll be in touch within one business day.</p>
    </div>
    <div id="form-error" class="form-error" role="alert" aria-live="polite" hidden>
      <p>Something went wrong. Please try again, or reach out directly by phone or email.</p>
    </div>
  </form>
</div>

<style>
  /* Keep the honeypot out of sight and out of the tab order for real users. */
  .botcheck-field {
    display: none !important;
  }

  .field-error {
    margin: 0;
    font-size: .85rem;
    color: #991B1B;
  }
</style>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success') as HTMLElement | null;
  const error   = document.getElementById('form-error')   as HTMLElement | null;
  const btn     = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  type FieldCheck = {
    id: string;
    validate: (value: string) => string | null;
  };

  // Simple, permissive shape check: something@something.tld, no spaces.
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const required = (message: string) => (v: string) => (v ? null : message);

  // Only fields actually rendered are checked, so a list emptied in the CMS cannot
  // leave the form permanently invalid.
  const CHECKS: FieldCheck[] = [
    { id: 'contact-name',    validate: required('Please enter your name.') },
    {
      id: 'contact-email',
      validate: (v) => {
        if (!v) return 'Please enter your email address.';
        return EMAIL_RE.test(v) ? null : 'Please enter a valid email address.';
      },
    },
    { id: 'contact-role',    validate: required('Please choose the option that fits you best.') },
    { id: 'contact-state',   validate: required('Please choose a state.') },
    { id: 'contact-county',  validate: required('Please enter the county or parish.') },
    { id: 'contact-service', validate: required('Please choose a service.') },
    { id: 'contact-message', validate: required('Please enter a message.') },
  ].filter((c) => document.getElementById(c.id));

  function setFieldError(id: string, message: string | null) {
    const field = document.getElementById(id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;
    const slot = document.getElementById(`${id}-error`);
    if (!field || !slot) return;

    if (message) {
      slot.textContent = message;
      slot.hidden = false;
      field.setAttribute('aria-invalid', 'true');
    } else {
      slot.textContent = '';
      slot.hidden = true;
      field.removeAttribute('aria-invalid');
    }
  }

  function validateField(check: FieldCheck): boolean {
    const field = document.getElementById(check.id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;
    if (!field) return true;

    const message = check.validate(field.value.trim());
    setFieldError(check.id, message);
    return message === null;
  }

  // Clear a field's error as soon as the visitor fixes it.
  for (const check of CHECKS) {
    const field = document.getElementById(check.id);
    field?.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(check);
    });
    field?.addEventListener('change', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(check);
    });
    field?.addEventListener('blur', () => {
      if ((field as HTMLInputElement).value.trim()) validateField(check);
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !success || !error || !btn) return;

    // Validate every field so all problems surface at once, then focus the first.
    let firstInvalid: HTMLElement | null = null;
    for (const check of CHECKS) {
      if (!validateField(check) && !firstInvalid) {
        firstInvalid = document.getElementById(check.id);
      }
    }
    if (firstInvalid) {
      success.hidden = true;
      error.hidden   = true;
      firstInvalid.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res  = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        for (const check of CHECKS) setFieldError(check.id, null);
        success.hidden = false;
        error.hidden   = true;
      } else {
        throw new Error(json.message || 'Submission failed');
      }
    } catch {
      error.hidden   = false;
      success.hidden = true;
    } finally {
      btn.disabled    = false;
      btn.textContent = 'Send Message';
    }
  });
</script>
