---
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';
import contact from '../data/pages/contact.json';
import { STATE_OPTIONS } from '../utils/state-options';
import owners from '../data/pages/mineral-owners.json';
import { text } from '../utils/labels';

// Web3Forms uses each field's name attribute as the label in the email it sends, so the
// new fields are named in plain words rather than in code style. `name`, `email` and
// `message` keep their original names because Web3Forms treats those specially.
const labels = contact.form_labels;
const shortForm = contact.short_form;

// Everything a visitor reads on the forms comes from the Contact page in the editor. Each
// piece falls back to its original wording if the field is left blank, so clearing a box
// can never leave a button or an error message empty.
const c = contact as Record<string, any>;
const fl = labels as Record<string, string>;
const ph = c.form_placeholders ?? {};
const fe = c.form_errors ?? {};
const se = shortForm?.errors ?? {};
const t = {
  nameLabel:      text(fl.name, 'Name'),
  emailLabel:     text(fl.email, 'Email'),
  messageLabel:   text(fl.message, 'Message'),
  choose:         text(c.choose_prompt, 'Please choose'),
  notSure:        text(c.service_not_sure, 'Not sure yet'),
  button:         text(c.form_button, 'Send Message'),
  sending:        text(c.form_sending, 'Sending…'),
  subject:        text(c.form_subject, 'New inquiry from website contact form'),
  shortSubject:   text(shortForm?.subject, 'New note from a landowner'),
  shortName:      text(shortForm?.name_label, 'Name'),
  shortButton:    text(shortForm?.button, 'Send it over'),
  phName:         text(ph.name, 'Your name'),
  phEmail:        text(ph.email, 'your@email.com'),
  phPhone:        text(ph.phone, '(555) 555-5555'),
  phCounty:       text(ph.county, 'Where the tract sits'),
  phMessage:      text(ph.message, 'Tell us about your project…'),
  errName:        text(fe.name, 'Please enter your name.'),
  errEmail:       text(fe.email_missing, 'Please enter your email address.'),
  errEmailBad:    text(fe.email_invalid, 'Please enter a valid email address.'),
  errRole:        text(fe.role, 'Please choose the option that fits you best.'),
  errState:       text(fe.state, 'Please choose a state.'),
  errCounty:      text(fe.county, 'Please enter the county or parish.'),
  errService:     text(fe.service, 'Please choose a service.'),
  errMessage:     text(fe.message, 'Please enter a message.'),
  errShortName:   text(se.name, 'Please enter your name.'),
  errShortContact:text(se.contact, 'Please give us a phone number or an email address.'),
  errShortCounty: text(se.county, 'Please tell us the county and state.'),
  errShortWhat:   text(se.what, 'Please tell us what showed up.'),
  stateOther:     text(c.state_other, 'Other / not sure'),
  ownerLink:      text(c.owner_note?.link_label, 'Send us a short note instead'),
};
// The line under each form saying what happens once it is sent. Blank hides it.
const shortAfter = shortForm?.after_note?.trim();
const projectAfter = c.form_after_note?.trim();

// With JavaScript on, the forms send in the background and show their own message in the
// page. With it off, the browser posts straight to Web3Forms, which then sends the visitor
// to this page on our own site rather than to a Web3Forms page. It must be a full https
// address on the same domain for the free plan. The script swaps it back to "false" before
// sending, so the in-page path sends exactly what it always has.
const sentUrl = new URL('/message-sent', Astro.site ?? 'https://plvinc.com').toString();
const inquirerTypes = (contact.inquirer_types || []).map((t) => t.label).filter(Boolean);
const timelines = (contact.timelines || []).map((t) => t.label).filter(Boolean);

// The service list comes from the services collection so the form can never offer
// something the site does not describe, or miss one that was added.
let serviceNames: string[] = [];
try {
  const services = await getCollection('services');
  serviceNames = [...services]
    .sort((a, b) => a.data.sort_order - b.data.sort_order)
    .map((s) => s.data.title);
} catch {
  serviceNames = [];
}

const stateNames = STATE_OPTIONS;

// "What you received", filled in when a visitor arrives from the guide or the calculator on
// Mineral Owners (/contact?received=lease-offer#note). The link carries only a key; the
// wording comes from the guide's choices in Studio, so a hand-made link cannot put arbitrary
// text into the form. An unknown key, or no key, leaves the box empty as before.
const prefill = Object.fromEntries(
  (((owners as any).received_guide?.choices ?? []) as { key?: string; prefill?: string }[])
    .filter((c) => c.key && c.prefill?.trim())
    .map((c) => [c.key, c.prefill!.trim()])
);
---

<div class="contact-form-block">
  {shortForm && (
    <>
      <input type="radio" name="form-path" id="path-short" class="form-path-input" checked />
      <input type="radio" name="form-path" id="path-project" class="form-path-input" />

      <div class="form-path-tabs" role="presentation">
        <label for="path-short" class="form-path-tab">{shortForm.tab_label}</label>
        <label for="path-project" class="form-path-tab">{shortForm.project_tab_label}</label>
      </div>

      <!-- Short path: four fields, for someone holding a letter they did not expect. -->
      <div class="form-panel form-panel-short">
        <h2>{shortForm.headline}</h2>
        <p class="form-intro">{shortForm.intro}</p>

        <form id="short-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={settings.web3forms_key} />
          <input type="hidden" name="subject" value={t.shortSubject} />
          <input type="hidden" name="redirect" value={sentUrl} />
          {settings.professional_name && <input type="hidden" name="from_name" value={settings.professional_name} />}

          <label class="botcheck-field" aria-hidden="true">
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
          </label>

          <div class="form-group">
            <label for="short-name">{t.shortName} <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" id="short-name" data-msg={t.errShortName} name="name" autocomplete="name" required
                   aria-describedby="short-name-error" />
            <p class="field-error" id="short-name-error" hidden></p>
          </div>

          <div class="form-group">
            <label for="short-contact">
              {shortForm.contact_label} <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input type="text" id="short-contact" data-msg={t.errShortContact} name="Phone or email" required
                   aria-describedby="short-contact-error" />
            <p class="field-error" id="short-contact-error" hidden></p>
          </div>

          <div class="form-group">
            <label for="short-county">
              {shortForm.county_label} <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input type="text" id="short-county" data-msg={t.errShortCounty} name="County and state" required
                   aria-describedby="short-county-error" />
            <p class="field-error" id="short-county-error" hidden></p>
          </div>

          <div class="form-group">
            <label for="short-message">
              {shortForm.what_label} <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <textarea id="short-message" data-msg={t.errShortWhat} data-prefill={JSON.stringify(prefill)} name="message" rows="5" required
                      aria-describedby="short-message-error"></textarea>
            <p class="field-error" id="short-message-error" hidden></p>
          </div>

          <button type="submit" class="btn btn-primary" data-sending={t.sending}>{t.shortButton}</button>
          {shortAfter && <p class="form-after">{shortAfter}</p>}

          <div id="short-success" tabindex="-1" class="form-success" role="status" aria-live="polite" hidden>
            <p>{shortForm.success}</p>
          </div>
          <div id="short-error" tabindex="-1" class="form-error" role="alert" hidden>
            <p>{contact.form_error}</p>
          </div>
        </form>
      </div>
    </>
  )}

  <div class:list={['form-panel', shortForm && 'form-panel-project']}>
  {/* Points a company that wants the background first to its own page, the way the
      Services pages point owners to Mineral Owners. Blank text hides it. */}
  {shortForm?.company_note?.text && (
    <p class="form-path-note">
      {shortForm.company_note.text}{' '}
      <a href="/companies">{text(shortForm.company_note.link_label, 'Read our page for companies')} <span aria-hidden="true">→</span></a>
    </p>
  )}
  <h2>{contact.form_headline}</h2>
  {contact.form_intro && <p class="form-intro">{contact.form_intro}</p>}
  {/* The project form is for companies. An owner who lands here is pointed to the short
      note, which asks for four things instead of nine. Blank text hides the line. */}
  {shortForm && c.owner_note?.text && (
    <p class="form-owner-note">
      {c.owner_note.text}{' '}
      <a href="/contact#note" class="form-switch-link" data-path="path-short">{t.ownerLink} <span aria-hidden="true">→</span></a>
    </p>
  )}

  <form
    id="contact-form"
    action="https://api.web3forms.com/submit"
    method="POST"
  >
    <input type="hidden" name="access_key"  value={settings.web3forms_key} />
    <input type="hidden" name="subject"     value={t.subject} />
    <input type="hidden" name="redirect"    value={sentUrl} />
    {settings.professional_name && <input type="hidden" name="from_name" value={settings.professional_name} />}

    <!-- Honeypot, hidden from people, left unchecked. Web3Forms silently
         rejects any submission where this arrives checked. -->
    <label class="botcheck-field" aria-hidden="true">
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>

    <div class="form-group">
      <label for="contact-name">
        {t.nameLabel} <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="contact-name" data-msg={t.errName}
        name="name"
        placeholder={t.phName}
        autocomplete="name"
        required
        aria-describedby="contact-name-error"
      />
      <p class="field-error" id="contact-name-error" hidden></p>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="contact-email">
          {t.emailLabel} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="contact-email" data-msg={t.errEmail} data-msg-invalid={t.errEmailBad}
          name="email"
          placeholder={t.phEmail}
          required
          autocomplete="email"
          aria-describedby="contact-email-error"
        />
        <p class="field-error" id="contact-email-error" hidden></p>
      </div>

      <div class="form-group">
        <label for="contact-phone">{labels.phone}</label>
        <input
          type="tel"
          id="contact-phone"
          name="Phone"
          placeholder={t.phPhone}
          autocomplete="tel"
        />
      </div>
    </div>

    {inquirerTypes.length > 0 && (
      <div class="form-group">
        <label for="contact-role">
          {labels.inquirer_type} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-role" data-msg={t.errRole}
          name="I am a"
          required
          aria-describedby="contact-role-error"
        >
          <option value="">{t.choose}</option>
          {inquirerTypes.map((t) => <option value={t}>{t}</option>)}
        </select>
        <p class="field-error" id="contact-role-error" hidden></p>
      </div>
    )}

    <div class="form-row">
      <div class="form-group">
        <label for="contact-state">
          {labels.state} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-state" data-msg={t.errState}
          name="State"
          required
          aria-describedby="contact-state-error"
        >
          <option value="">{t.choose}</option>
          {stateNames.map((s) => <option value={s}>{s}</option>)}
          <option value={t.stateOther}>{t.stateOther}</option>
        </select>
        <p class="field-error" id="contact-state-error" hidden></p>
      </div>

      <div class="form-group">
        <label for="contact-county">
          {labels.county} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="contact-county" data-msg={t.errCounty}
          name="County or parish"
          placeholder={t.phCounty}
          required
          aria-describedby="contact-county-error"
        />
        <p class="field-error" id="contact-county-error" hidden></p>
      </div>
    </div>

    {serviceNames.length > 0 && (
      <div class="form-group">
        <label for="contact-service">
          {labels.service} <span class="required-mark" aria-hidden="true">*</span>
        </label>
        <select
          id="contact-service" data-msg={t.errService}
          name="Service needed"
          required
          aria-describedby="contact-service-error"
        >
          <option value="">{t.choose}</option>
          {serviceNames.map((s) => <option value={s}>{s}</option>)}
          <option value={t.notSure}>{t.notSure}</option>
        </select>
        <p class="field-error" id="contact-service-error" hidden></p>
      </div>
    )}

    {timelines.length > 0 && (
      <div class="form-group">
        <label for="contact-timeline">{labels.timeline}</label>
        <select id="contact-timeline" name="Timeline">
          <option value="">{t.choose}</option>
          {timelines.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
    )}

    <div class="form-group">
      <label for="contact-message">
        {t.messageLabel} <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message" data-msg={t.errMessage}
        name="message"
        rows="6"
        placeholder={t.phMessage}
        required
        aria-describedby="contact-message-error"
      ></textarea>
      <p class="field-error" id="contact-message-error" hidden></p>
    </div>

    <button type="submit" class="btn btn-primary" data-sending={t.sending}>{t.button}</button>
    {projectAfter && <p class="form-after">{projectAfter}</p>}

    <div id="form-success" tabindex="-1" class="form-success" role="status" aria-live="polite" hidden>
      <p>{contact.form_success}</p>
    </div>
    <div id="form-error" tabindex="-1" class="form-error" role="alert" hidden>
      <p>{contact.form_error}</p>
    </div>
  </form>
  </div>
</div>

<style>
  /* The result message takes focus so a screen reader reads it and a phone scrolls to
     it. It is not a control, so it does not need the focus ring. */
  .form-success:focus,
  .form-error:focus {
    outline: none;
  }

  /* Keep the honeypot out of sight and out of the tab order for real users. */
  .botcheck-field {
    display: none !important;
  }

  .field-error {
    margin: 0;
    font-size: .85rem;
    color: #991B1B;
  }
</style>

<script>
  // A link to /contact#project (the home page's "I represent a company" button) opens the
  // project form; /contact#note opens the landowner note. Without a hash the landowner
  // note shows, as before. Either way the form is scrolled into view, since on a phone the
  // contact details above it fill the first screen.
  function openFormFromHash() {
    const which = location.hash === '#project' ? 'path-project'
      : location.hash === '#note' ? 'path-short'
      : null;
    if (!which) return;
    const radio = document.getElementById(which) as HTMLInputElement | null;
    if (!radio) return;
    radio.checked = true;
    document.querySelector('.contact-form-block')?.scrollIntoView({ block: 'start' });
  }
  openFormFromHash();
  window.addEventListener('hashchange', openFormFromHash);

  // Fill in "What you received" from ?received=…, only when the box is still empty, so a
  // note the browser kept from an earlier visit is never overwritten. The visitor can edit
  // or clear it like anything else they type.
  (() => {
    const key = new URLSearchParams(location.search).get('received');
    const box = document.getElementById('short-message') as HTMLTextAreaElement | null;
    if (!key || !box || box.value.trim()) return;
    let map: Record<string, string> = {};
    try { map = JSON.parse(box.dataset.prefill || '{}'); } catch { map = {}; }
    if (!Object.prototype.hasOwnProperty.call(map, key)) return;
    box.value = `${map[key]} `;
    const radio = document.getElementById('path-short') as HTMLInputElement | null;
    if (radio) radio.checked = true;
  })();

  // "Send us a short note instead" on the project form. A hash link alone does nothing when
  // the address already ends in #note, so the switch is made here, and focus moves to the
  // first box of the short note so a keyboard or screen reader user lands in it.
  document.querySelectorAll<HTMLAnchorElement>('.form-switch-link').forEach((a) => {
    a.addEventListener('click', (e) => {
      const radio = document.getElementById(a.dataset.path ?? '') as HTMLInputElement | null;
      if (!radio) return;
      e.preventDefault();
      radio.checked = true;
      history.replaceState(null, '', '#note');
      document.querySelector('.contact-form-block')?.scrollIntoView({ block: 'start' });
      (document.querySelector('#short-form input:not([type="hidden"]):not([name="botcheck"])') as HTMLElement | null)?.focus({ preventScroll: true });
    });
  });

  // Without JavaScript the browser's own checks stop an empty form. With it, these scripts
  // take over and show the messages written in Studio instead.
  document.querySelectorAll<HTMLFormElement>('#short-form, #contact-form').forEach((f) => { f.noValidate = true; });

  // What is sent from the page: the form as typed, with the redirect swapped back to the
  // value the in-page path has always sent (the redirect address is only for visitors
  // without JavaScript).
  function payload(f: HTMLFormElement) {
    const data = new FormData(f);
    data.set('redirect', 'false');
    return data;
  }

  // The short path posts to the same endpoint with its own four checks.
  const shortForm    = document.getElementById('short-form') as HTMLFormElement | null;
  const shortSuccess = document.getElementById('short-success') as HTMLElement | null;
  const shortError   = document.getElementById('short-error')   as HTMLElement | null;
  const shortBtn     = shortForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const shortLabel   = shortBtn?.textContent ?? '';

  // The wording of each message is set on the field itself (data-msg), from the editor.
  const msg = (id: string, key = 'msg') => document.getElementById(id)?.dataset[key] ?? '';

  const SHORT_CHECKS: { id: string; message: string }[] = [
    'short-name', 'short-contact', 'short-county', 'short-message',
  ].map((id) => ({ id, message: msg(id) }));

  function setShortError(id: string, message: string | null) {
    const field = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    const slot  = document.getElementById(`${id}-error`);
    if (!field || !slot) return;
    slot.textContent = message ?? '';
    slot.hidden = !message;
    if (message) field.setAttribute('aria-invalid', 'true');
    else field.removeAttribute('aria-invalid');
  }

  shortForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!shortForm || !shortSuccess || !shortError || !shortBtn) return;

    let firstInvalid: HTMLElement | null = null;
    for (const c of SHORT_CHECKS) {
      const field = document.getElementById(c.id) as HTMLInputElement | HTMLTextAreaElement | null;
      const bad = !field?.value.trim();
      setShortError(c.id, bad ? c.message : null);
      if (bad && !firstInvalid) firstInvalid = field;
    }
    if (firstInvalid) {
      shortSuccess.hidden = true;
      shortError.hidden = true;
      firstInvalid.focus();
      return;
    }

    shortBtn.disabled = true;
    shortBtn.textContent = shortBtn.dataset.sending || shortLabel;
    try {
      const data = payload(shortForm);
      // The short note asks for "phone or email" in one box. When it holds an email address,
      // it becomes the reply-to, so answering the notification email goes to the visitor.
      const contactValue = (document.getElementById('short-contact') as HTMLInputElement | null)?.value.trim() ?? '';
      if (EMAIL_RE.test(contactValue)) data.set('replyto', contactValue);
      const res  = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();
      if (!json.success) throw new Error('Submission failed');
      shortForm.reset();
      for (const c of SHORT_CHECKS) setShortError(c.id, null);
      shortSuccess.hidden = false;
      shortError.hidden = true;
      shortSuccess.focus();
    } catch {
      shortError.hidden = false;
      shortSuccess.hidden = true;
      shortError.focus();
    } finally {
      shortBtn.disabled = false;
      shortBtn.textContent = shortLabel;
    }
  });

  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success') as HTMLElement | null;
  const error   = document.getElementById('form-error')   as HTMLElement | null;
  const btn     = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const btnLabel = btn?.textContent ?? '';

  type FieldCheck = {
    id: string;
    validate: (value: string) => string | null;
  };

  // Simple, permissive shape check: something@something.tld, no spaces.
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const required = (message: string) => (v: string) => (v ? null : message);

  // Only fields actually rendered are checked, so a list emptied in the CMS cannot
  // leave the form permanently invalid.
  const CHECKS: FieldCheck[] = [
    { id: 'contact-name',    validate: required(msg('contact-name')) },
    {
      id: 'contact-email',
      validate: (v) => {
        if (!v) return msg('contact-email');
        return EMAIL_RE.test(v) ? null : msg('contact-email', 'msgInvalid');
      },
    },
    { id: 'contact-role',    validate: required(msg('contact-role')) },
    { id: 'contact-state',   validate: required(msg('contact-state')) },
    { id: 'contact-county',  validate: required(msg('contact-county')) },
    { id: 'contact-service', validate: required(msg('contact-service')) },
    { id: 'contact-message', validate: required(msg('contact-message')) },
  ].filter((c) => document.getElementById(c.id));

  function setFieldError(id: string, message: string | null) {
    const field = document.getElementById(id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;
    const slot = document.getElementById(`${id}-error`);
    if (!field || !slot) return;

    if (message) {
      slot.textContent = message;
      slot.hidden = false;
      field.setAttribute('aria-invalid', 'true');
    } else {
      slot.textContent = '';
      slot.hidden = true;
      field.removeAttribute('aria-invalid');
    }
  }

  function validateField(check: FieldCheck): boolean {
    const field = document.getElementById(check.id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;
    if (!field) return true;

    const message = check.validate(field.value.trim());
    setFieldError(check.id, message);
    return message === null;
  }

  // Clear a field's error as soon as the visitor fixes it.
  for (const check of CHECKS) {
    const field = document.getElementById(check.id);
    field?.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(check);
    });
    field?.addEventListener('change', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(check);
    });
    field?.addEventListener('blur', () => {
      if ((field as HTMLInputElement).value.trim()) validateField(check);
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !success || !error || !btn) return;

    // Validate every field so all problems surface at once, then focus the first.
    let firstInvalid: HTMLElement | null = null;
    for (const check of CHECKS) {
      if (!validateField(check) && !firstInvalid) {
        firstInvalid = document.getElementById(check.id);
      }
    }
    if (firstInvalid) {
      success.hidden = true;
      error.hidden   = true;
      firstInvalid.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = btn.dataset.sending || btnLabel;

    try {
      const res  = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: payload(form),
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        for (const check of CHECKS) setFieldError(check.id, null);
        success.hidden = false;
        error.hidden   = true;
        success.focus();
      } else {
        throw new Error(json.message || 'Submission failed');
      }
    } catch {
      error.hidden   = false;
      success.hidden = true;
      error.focus();
    } finally {
      btn.disabled    = false;
      btn.textContent = btnLabel;
    }
  });
</script>
