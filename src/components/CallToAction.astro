---
// The closing call to action, shared by every page. Previously this markup was
// copy-pasted into five templates with the copy hardcoded, so the owner could not
// change any of it and all five ended in the same button.
//
// `tone` alternates the background so a page does not open and close on the same
// dark green band. Pages whose header is dark should pass tone="light".
//
// `image` is decorative only and applies to the dark tone, where the copy is
// already reversed out of a green field. The light variant has dark text on a
// pale background, so a photo behind it would not hold contrast.
import { cssUrl } from '../utils/cssUrl';

interface Props {
  headline: string;
  text?: string;
  button?: string;
  href?: string;
  tone?: 'dark' | 'light';
  image?: string;
  /** Optional tappable number shown beside the button, for the pages where
      picking up the phone is the likelier next step than filling in a form. */
  phone?: string;
  phoneHref?: string;
}

const {
  headline,
  text,
  button = 'Get in Touch',
  href = '/contact',
  tone = 'dark',
  image,
  phone,
  phoneHref,
} = Astro.props;

const showImage = Boolean(image) && tone === 'dark';
---

<section
  class:list={['cta-band', tone === 'light' && 'cta-band-light', showImage && 'cta-band-image']}
  style={showImage ? `--cta-image: ${cssUrl(image!)}` : undefined}
>
  <div class="container">
    <h2>{headline}</h2>
    {text && <p>{text}</p>}
    <div class="cta-actions">
      <a href={href} class:list={['btn', tone === 'light' ? 'btn-primary' : 'btn-white']}>
        {button} <span aria-hidden="true">→</span>
      </a>
      {phone && phoneHref && (
        <a href={phoneHref} class="cta-phone" aria-label={`Call ${phone}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
          </svg>
          {phone}
        </a>
      )}
    </div>
  </div>
</section>
