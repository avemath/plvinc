---
// The main menu: the logo (home), four items and a contact button. The wording and the
// grouping live in src/data/menu.json (Site Settings → Main Menu in the editor); the six
// services fill the Services list by themselves. The footer keeps its own full link list.
import { hasInsightFiles } from '../utils/insight-files';
import { navLabels } from '../utils/labels';
import { text } from '../utils/labels';
import { getCollection } from 'astro:content';
import { telHref } from '../utils/phone';
import { srcsetFor } from '../utils/images';
import menu from '../data/menu.json';

interface Props {
  settings: {
    professional_name: string;
    logo?: string;
    logo_small?: string;
    phone?: string;
  };
}

const { settings } = Astro.props;
const hasInsights = hasInsightFiles();
const path = Astro.url.pathname;

// "page" for the page itself; "true" for a section the visitor is inside (a service page
// marks Services as current, but Services is not the page they are on). build.format is
// 'file', so pages arrive as /about.html and the home page as /index.html.
function current(href: string): 'page' | 'true' | undefined {
  if (!href) return undefined;
  if (path === href || path === `${href}.html`) return 'page';
  return path.startsWith(`${href}/`) ? 'true' : undefined;
}

type Link = { label: string; href: string };
type Item =
  | { kind: 'link'; id: string; label: string; href: string }
  | { kind: 'group'; id: string; label: string; links: Link[]; all?: Link };

// The six services, in their display order, then a link to the overview.
const services = (await getCollection('services'))
  .sort((a, b) => a.data.sort_order - b.data.sort_order)
  .map((s) => ({ href: `/services/${s.id}`, label: s.data.title }));

const items: Item[] = [];
if (services.length > 0) {
  items.push({
    kind: 'group',
    id: 'services',
    label: text(menu.services_label, 'Services'),
    links: services,
    all: { label: text(menu.services_all_label, 'All services'), href: '/services' },
  });
}
(menu.groups ?? []).forEach((g, i) => {
  const links = (g.items ?? [])
    .filter((l) => l?.label?.trim() && l?.link)
    .map((l) => ({ label: l.label.trim(), href: l.link }));
  // Insights joins the About list once the first article exists.
  if (hasInsights && links.some((l) => l.href === '/about')) {
    links.push({ label: navLabels.insights, href: '/insights' });
  }
  if (!g.label?.trim()) return;
  if (links.length > 0) items.push({ kind: 'group', id: `group-${i}`, label: g.label.trim(), links });
  else if (g.link) items.push({ kind: 'link', id: `link-${i}`, label: g.label.trim(), href: g.link });
});

// A group is current when the visitor is on any page inside it.
const groupCurrent = (it: Item) =>
  it.kind === 'group'
    ? [...it.links, ...(it.all ? [it.all] : [])].some((l) => current(l.href))
    : Boolean(current(it.href));

// The header shows the wide PETROLAND wordmark at every width. The round badge was tried
// on desktop, but its file is small and the words inside it, VENTURES above all, could not
// be read at any height the header can hold. One mark also makes desktop, phone and the
// footer read as the same brand. The badge is the fallback if no wordmark is uploaded.
const navLogo = settings.logo_small || settings.logo;
const isWordmark = Boolean(settings.logo_small);
const tel = telHref(settings.phone);
const contactLabel = text(menu.contact_button, 'Get in touch');
---

<header class="site-header">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label={`${settings.professional_name}, home`}>
      {navLogo
        ? (
          <img
            src={navLogo}
            srcset={srcsetFor(navLogo, isWordmark ? 465 : 245)}
            sizes={isWordmark ? '165px' : '85px'}
            alt={settings.professional_name}
            class:list={['nav-logo-img', isWordmark && 'is-wordmark']}
            width={isWordmark ? 465 : 245}
            height={isWordmark ? 132 : 174}
          />
        )
        : <span class="nav-logo-text">{settings.professional_name}</span>
      }
    </a>

    <div class="nav-menu" id="nav-menu">
      <ul class="nav-list" role="list">
        {items.map((it) => (
          it.kind === 'group'
            ? (
              <li class:list={['nav-item', 'has-sub', groupCurrent(it) && 'is-current']}>
                <button
                  type="button"
                  class="nav-trigger"
                  id={`nav-trigger-${it.id}`}
                  aria-expanded="false"
                  aria-controls={`nav-sub-${it.id}`}
                >
                  <span>{it.label}</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                       stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <ul class="nav-sub" id={`nav-sub-${it.id}`} role="list">
                  {it.links.map((l) => (
                    <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>
                  ))}
                  {it.all && (
                    <li class="nav-sub-all">
                      <a href={it.all.href} aria-current={current(it.all.href) === 'page' ? 'page' : undefined}>
                        {it.all.label} <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  )}
                </ul>
              </li>
            )
            : (
              <li class:list={['nav-item', groupCurrent(it) && 'is-current']}>
                <a href={it.href} class="nav-top-link" aria-current={current(it.href)}>{it.label}</a>
              </li>
            )
        ))}
      </ul>

      {/* In the phone menu only: the number in full and the contact button. */}
      <div class="nav-menu-extra">
        {settings.phone && <a href={tel} class="nav-menu-phone">{settings.phone}</a>}
        <a href="/contact" class="btn btn-primary nav-menu-cta" aria-current={current('/contact')}>{contactLabel}</a>
      </div>
    </div>

    <div class="nav-actions">
      {settings.phone && (
        <a href={tel} class="nav-phone" aria-label={`Call ${settings.phone}`}>
          <svg
            class="nav-phone-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
          </svg>
          <span class="nav-phone-number">{settings.phone}</span>
        </a>
      )}

      <a href="/contact" class="btn btn-primary nav-cta" aria-current={current('/contact')}>{contactLabel}</a>

      <button
        class="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Disclosure menus: each group is a button that shows or hides its own list. The same
  // markup serves the desktop dropdowns and the phone menu's collapsible groups.
  const DESKTOP = window.matchMedia('(min-width: 861px)');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('#nav-menu');
  const groups = [...document.querySelectorAll<HTMLElement>('.nav-item.has-sub')];
  const topLevel = [...document.querySelectorAll<HTMLElement>('.nav-trigger, .nav-top-link')];

  const triggerOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>('.nav-trigger')!;
  const linksOf = (g: HTMLElement) => [...g.querySelectorAll<HTMLAnchorElement>('.nav-sub a')];

  // Lists a mouse opened by hovering. A click that follows confirms the list rather than
  // shutting it again under the pointer.
  const hoverOpened = new WeakSet<HTMLElement>();

  function setOpen(g: HTMLElement, open: boolean) {
    if (!open) hoverOpened.delete(g);
    g.classList.toggle('is-open', open);
    triggerOf(g).setAttribute('aria-expanded', String(open));
  }
  function closeAll(except?: HTMLElement) {
    groups.forEach((g) => { if (g !== except) setOpen(g, false); });
  }

  groups.forEach((g) => {
    const trigger = triggerOf(g);

    // Click and tap. On a desktop only one list is open at a time; in the phone menu
    // several groups can be open together.
    trigger.addEventListener('click', () => {
      if (hoverOpened.has(g)) { hoverOpened.delete(g); return; }
      const open = !g.classList.contains('is-open');
      if (DESKTOP.matches) closeAll(g);
      setOpen(g, open);
    });

    // Hover, for a mouse on a desktop. A short delay on leaving lets the pointer cross
    // the gap between the button and the list.
    let leaveTimer: number | undefined;
    g.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !DESKTOP.matches) return;
      clearTimeout(leaveTimer);
      if (g.classList.contains('is-open')) return;
      closeAll(g);
      setOpen(g, true);
      hoverOpened.add(g);
    });
    g.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !DESKTOP.matches) return;
      leaveTimer = window.setTimeout(() => {
        if (!g.contains(document.activeElement)) setOpen(g, false);
      }, 180);
    });

    // Keyboard: arrows into and through the list, Escape back to the button.
    g.addEventListener('keydown', (e) => {
      const links = linksOf(g);
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      const onTrigger = document.activeElement === trigger;
      if (e.key === 'Escape' && g.classList.contains('is-open')) {
        e.preventDefault();
        e.stopPropagation();
        setOpen(g, false);
        trigger.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (onTrigger) { if (DESKTOP.matches) closeAll(g); setOpen(g, true); links[0]?.focus(); }
        else if (i >= 0) links[(i + 1) % links.length].focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (onTrigger) { if (DESKTOP.matches) closeAll(g); setOpen(g, true); links.at(-1)?.focus(); }
        else if (i >= 0) links[(i - 1 + links.length) % links.length].focus();
      } else if ((e.key === 'Home' || e.key === 'End') && i >= 0) {
        e.preventDefault();
        (e.key === 'Home' ? links[0] : links.at(-1))?.focus();
      }
    });

    // Tabbing out of a desktop list closes it.
    g.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (DESKTOP.matches && next && !g.contains(next)) setOpen(g, false);
    });
  });

  // Left and right move between the top items on a desktop, from a button or a list.
  document.querySelector('.nav-list')?.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (!DESKTOP.matches || (ke.key !== 'ArrowLeft' && ke.key !== 'ArrowRight')) return;
    const item = (ke.target as HTMLElement).closest('.nav-item');
    const from = topLevel.findIndex((t) => t.closest('.nav-item') === item);
    if (from < 0) return;
    ke.preventDefault();
    closeAll();
    const to = (from + (ke.key === 'ArrowRight' ? 1 : -1) + topLevel.length) % topLevel.length;
    topLevel[to].focus();
  });

  // A click anywhere else closes an open desktop list.
  document.addEventListener('click', (e) => {
    if (DESKTOP.matches && !(e.target as HTMLElement).closest('.nav-item.has-sub')) closeAll();
  });

  // The phone menu.
  const closeMenu = () => {
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const isOpen = !!menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) {
      // Open the group holding the current page, so the visitor sees where they are.
      groups.forEach((g) => setOpen(g, g.classList.contains('is-current')));
      // The menu comes before the button in the page, so move focus into it.
      menu?.querySelector<HTMLElement>('button, a')?.focus();
    }
  });
  menu?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (!DESKTOP.matches && menu.classList.contains('is-open') && next && !menu.contains(next) && next !== toggle) {
      closeMenu();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu?.classList.contains('is-open')) { closeMenu(); toggle?.focus(); }
    else closeAll();
  });

  // Moving between the phone and desktop layouts starts from a clean state.
  DESKTOP.addEventListener('change', () => { closeAll(); closeMenu(); });
</script>
