---
import { getCollection } from 'astro:content';

interface Props {
  settings: {
    professional_name: string;
    logo?: string;
    logo_small?: string;
    phone?: string;
  };
}

const { settings } = Astro.props;
let hasPeople = false;
try {
  const people = await getCollection('people');
  hasPeople = people.length > 0;
} catch {
  hasPeople = false;
}

// Insights is dormant until something is written, so the link only appears then.
let hasInsights = false;
try {
  hasInsights = (await getCollection('insights')).length > 0;
} catch {
  hasInsights = false;
}
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}

// The full logo is a badge, roughly square, so it needs height to stay legible. The narrow
// wordmark reads better in a cramped header, so small screens get that instead. Both are
// rendered and CSS picks one, which avoids a layout shift from swapping the src in script.
const logoFull = settings.logo;
const logoSmall = settings.logo_small || settings.logo;
const telHref = settings.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : '';
---

<header class="site-header">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label={`${settings.professional_name} — home`}>
      {logoFull || logoSmall
        ? (
          <>
            {logoFull && (
              <img
                src={logoFull}
                alt={settings.professional_name}
                class="nav-logo-img nav-logo-img-wide"
                width="245"
                height="174"
              />
            )}
            {logoSmall && (
              <img
                src={logoSmall}
                alt={logoFull ? '' : settings.professional_name}
                aria-hidden={logoFull ? 'true' : undefined}
                class="nav-logo-img nav-logo-img-narrow"
                width="465"
                height="132"
              />
            )}
          </>
        )
        : <span class="nav-logo-text">{settings.professional_name}</span>
      }
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      <li><a href="/"           aria-current={isActive('/')           ? 'page' : undefined}>Home</a></li>
      <li><a href="/about"      aria-current={isActive('/about')      ? 'page' : undefined}>About</a></li>
      <li><a href="/services"   aria-current={isActive('/services')   ? 'page' : undefined}>Services</a></li>
      <li><a href="/mineral-owners" aria-current={isActive('/mineral-owners') ? 'page' : undefined}>Mineral Owners</a></li>
      <li><a href="/experience" aria-current={isActive('/experience') ? 'page' : undefined}>Experience</a></li>
      {hasPeople && (
        <li><a href="/people"   aria-current={isActive('/people')     ? 'page' : undefined}>Team</a></li>
      )}
      {hasInsights && (
        <li><a href="/insights" aria-current={isActive('/insights')   ? 'page' : undefined}>Insights</a></li>
      )}
      <li><a href="/contact"    aria-current={isActive('/contact')    ? 'page' : undefined}>Contact</a></li>
      {settings.phone && (
        <li class="nav-links-phone">
          <a href={telHref}>{settings.phone}</a>
        </li>
      )}
    </ul>

    <div class="nav-actions">
      {settings.phone && (
        <a href={telHref} class="nav-phone" aria-label={`Call ${settings.phone}`}>
          <svg
            class="nav-phone-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
          </svg>
          <span class="nav-phone-number">{settings.phone}</span>
        </a>
      )}

      <button
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links  = document.querySelector<HTMLElement>('#nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && links?.classList.contains('is-open')) {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
