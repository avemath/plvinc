---
import { hasInsightFiles } from '../utils/insight-files';
import { navLabels, NAV_PAGES } from '../utils/labels';
import { getCollection } from 'astro:content';
import { telHref } from '../utils/phone';
import { srcsetFor } from '../utils/images';

interface Props {
  settings: {
    professional_name: string;
    logo?: string;
    logo_small?: string;
    phone?: string;
  };
}

const { settings } = Astro.props;
// Insights is dormant until something is written, so the link only appears then.
const hasInsights = hasInsightFiles();
const path = Astro.url.pathname;

// "page" for the page itself; "true" for a section the visitor is inside (a service page
// marks Services as current, but Services is not the page they are on). build.format is
// 'file', so pages arrive as /about.html and the home page as /index.html.
function current(href: string): 'page' | 'true' | undefined {
  if (href === '/') return path === '/' || path === '/index.html' ? 'page' : undefined;
  if (path === href || path === `${href}.html`) return 'page';
  return path.startsWith(`${href}/`) ? 'true' : undefined;
}

// The six services, in their display order, for the Services dropdown.
const services = (await getCollection('services'))
  .sort((a, b) => a.data.sort_order - b.data.sort_order)
  .map((s) => ({ href: `/services/${s.id}`, title: s.data.title }));

// The full logo is a badge, roughly square, so it needs height to stay legible. The narrow
// wordmark reads better in a cramped header, so small screens get that instead. Both are
// rendered and CSS picks one, which avoids a layout shift from swapping the src in script.
const logoFull = settings.logo;
const logoSmall = settings.logo_small || settings.logo;
const tel = telHref(settings.phone);
const desktopLogo = logoFull || logoSmall;
const mobileLogo = logoSmall || logoFull;
---

<header class="site-header">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label={`${settings.professional_name}, home`}>
      {desktopLogo
        ? (
          // One <picture>, so a phone downloads only the wide mark and a desktop only the
          // stacked logo. With just one of the two uploaded, it is used at every width.
          <picture>
            {mobileLogo !== desktopLogo && (
              <source media="(max-width: 768px)" srcset={srcsetFor(mobileLogo, 465) || mobileLogo} sizes="150px" width="465" height="132" />
            )}
            <img
              src={desktopLogo}
              srcset={srcsetFor(desktopLogo, logoFull ? 245 : 465)}
              sizes={logoFull ? '85px' : '210px'}
              alt={settings.professional_name}
              class="nav-logo-img"
              width={logoFull ? 245 : 465}
              height={logoFull ? 174 : 132}
            />
          </picture>
        )
        : <span class="nav-logo-text">{settings.professional_name}</span>
      }
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {NAV_PAGES.filter((p) => p.key !== 'insights' || hasInsights).map((p) => (
        p.key === 'services' && services.length > 0
          ? (
            <li class="nav-has-sub">
              <a href={p.href} aria-current={current(p.href)}>{navLabels[p.key]}</a>
              <button
                type="button"
                class="nav-sub-toggle"
                aria-expanded="false"
                aria-controls="nav-sub-services"
                aria-label={`Show each of the ${navLabels[p.key]}`}
              >
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <ul class="nav-sub" id="nav-sub-services" role="list">
                {services.map((s) => (
                  <li><a href={s.href} aria-current={current(s.href)}>{s.title}</a></li>
                ))}
              </ul>
            </li>
          )
          : <li><a href={p.href} aria-current={current(p.href)}>{navLabels[p.key]}</a></li>
      ))}
      {settings.phone && (
        <li class="nav-links-phone">
          <a href={tel}>{settings.phone}</a>
        </li>
      )}
    </ul>

    <div class="nav-actions">
      {settings.phone && (
        <a href={tel} class="nav-phone" aria-label={`Call ${settings.phone}`}>
          <svg
            class="nav-phone-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
          </svg>
          <span class="nav-phone-number">{settings.phone}</span>
        </a>
      )}

      <button
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links  = document.querySelector<HTMLElement>('#nav-links');

  // The Services sub-list. On a wide screen it also opens on hover and keyboard focus
  // (CSS); the button makes it work by tap and by click, and is the only way in the
  // phone menu.
  const subToggle = document.querySelector<HTMLButtonElement>('.nav-sub-toggle');
  const subItem = subToggle?.closest('.nav-has-sub');
  subToggle?.addEventListener('click', () => {
    subItem?.classList.remove('is-dismissed');
    const open = subItem?.classList.toggle('is-open');
    subToggle.setAttribute('aria-expanded', String(!!open));
  });
  subItem?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (next && !subItem.contains(next) && window.matchMedia('(min-width: 769px)').matches) {
      subItem.classList.remove('is-open');
      subToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  const closeMenu = () => {
    links?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
    // The list comes before the button in the page, so after opening the menu the next
    // Tab would skip past it. Move focus into the menu instead.
    if (isOpen) links?.querySelector<HTMLAnchorElement>('a')?.focus();
  });

  // Close the menu once focus leaves both the menu and its button.
  links?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (links.classList.contains('is-open') && next && !links.contains(next) && next !== toggle) {
      closeMenu();
    }
  });

  // Escape also has to close a list that hover opened, so it stays shut until the
  // pointer leaves the item.
  subItem?.addEventListener('mouseleave', () => subItem.classList.remove('is-dismissed'));

  document.addEventListener('keydown', (e) => {
    const subShown = subItem?.classList.contains('is-open') || subItem?.matches(':hover');
    if (e.key === 'Escape' && subItem && subShown && window.matchMedia('(min-width: 769px)').matches) {
      const hadFocus = subItem.contains(document.activeElement);
      subItem.classList.remove('is-open');
      if (subItem.matches(':hover')) subItem.classList.add('is-dismissed');
      subToggle?.setAttribute('aria-expanded', 'false');
      if (hadFocus) subToggle?.focus();
      return;
    }
    if (e.key === 'Escape' && subItem?.classList.contains('is-open')) {
      subItem.classList.remove('is-open');
      subToggle?.setAttribute('aria-expanded', 'false');
      subToggle?.focus();
      return;
    }
    if (e.key === 'Escape' && links?.classList.contains('is-open')) {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
