---
import { getCollection } from 'astro:content';

interface Props {
  settings: {
    professional_name: string;
    footer_name?: string;
    tagline?: string;
    phone?: string;
    email?: string;
    service_area_summary?: string;
    logo_small_light?: string;
    based_in?: string;
    city?: string;
    state?: string;
    linkedin_url?: string;
  };
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
const name = settings.footer_name || settings.professional_name;

let hasInsights = false;
try {
  hasInsights = (await getCollection('insights')).length > 0;
} catch {
  hasInsights = false;
}

// based_in is what visitors read, and it can be a region rather than a town. Falling back
// to city and state keeps working for anyone who fills those in instead.
const location = settings.based_in
  || (settings.city && settings.state ? `${settings.city}, ${settings.state}` : '');
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      {settings.logo_small_light
        ? <img
            src={settings.logo_small_light}
            alt={name}
            class="footer-logo"
            width="465"
            height="132"
            loading="lazy"
          />
        : <p class="footer-name">{name}</p>
      }
      {settings.tagline && <p class="footer-tagline">{settings.tagline}</p>}
      {settings.service_area_summary && (
        <p class="footer-area">{settings.service_area_summary}</p>
      )}
    </div>

    <div>
      <span class="footer-col-label">Contact</span>
      <div class="footer-contact">
        {settings.phone && (
          <a
            href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}
            class="footer-link"
            aria-label={`Call ${settings.phone}`}
          >
            {settings.phone}
          </a>
        )}
        {settings.email && (
          <a
            href={`mailto:${settings.email}`}
            class="footer-link"
          >
            {settings.email}
          </a>
        )}
        {location && <address class="footer-location">{location}</address>}
        {settings.linkedin_url && (
          <a
            href={settings.linkedin_url}
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        )}
      </div>
    </div>

    <div>
      <span class="footer-col-label">Navigation</span>
      <nav class="footer-nav-links" aria-label="Footer navigation">
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/mineral-owners">Mineral Owners</a>
        <a href="/experience">Experience</a>
        {hasInsights && <a href="/insights">Insights</a>}
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} {name}. All rights reserved.</p>
    <a href="/privacy">Privacy</a>
  </div>
</footer>
