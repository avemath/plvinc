---
import { hasInsightFiles } from '../utils/insight-files';
import LinkedInIcon from './LinkedInIcon.astro';
import { getLinkedInProfiles } from '../utils/people';
import { navLabels, footerLabels, NAV_PAGES } from '../utils/labels';

interface Props {
  settings: {
    professional_name: string;
    footer_name?: string;
    tagline?: string;
    phone?: string;
    email?: string;
    service_area_summary?: string;
    footer_scope_line?: string;
    logo_small_light?: string;
    based_in?: string;
    city?: string;
    state?: string;
    linkedin_url?: string;
  };
}

const { settings } = Astro.props;
const profiles = await getLinkedInProfiles();
const year = new Date().getFullYear();
const name = settings.footer_name || settings.professional_name;

const hasInsights = hasInsightFiles();

// based_in is what visitors read, and it can be a region rather than a town. Falling back
// to city and state keeps working for anyone who fills those in instead.
const location = settings.based_in
  || (settings.city && settings.state ? `${settings.city}, ${settings.state}` : '');
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      {settings.logo_small_light
        ? <img
            src={settings.logo_small_light}
            alt={name}
            class="footer-logo"
            width="465"
            height="132"
            loading="lazy"
          />
        : <p class="footer-name">{name}</p>
      }
      {settings.tagline && <p class="footer-tagline">{settings.tagline}</p>}
      {settings.service_area_summary && (
        <p class="footer-area">{settings.service_area_summary}</p>
      )}
    </div>

    <div>
      <span class="footer-col-label">{footerLabels.contact_heading}</span>
      <div class="footer-contact">
        {settings.phone && (
          <a
            href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}
            class="footer-link"
            aria-label={`Call ${settings.phone}`}
          >
            {settings.phone}
          </a>
        )}
        {settings.email && (
          <a
            href={`mailto:${settings.email}`}
            class="footer-link"
          >
            {settings.email}
          </a>
        )}
        {location && <address class="footer-location">{location}</address>}
        {settings.linkedin_url && (
          <a
            href={settings.linkedin_url}
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        )}
        {profiles.map((p) => (
          <a
            href={p.url}
            class="footer-link footer-linkedin"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${p.name} on LinkedIn (opens in a new tab)`}
          >
            <LinkedInIcon size={14} />
            <span>{p.name}</span>
          </a>
        ))}
      </div>
    </div>

    <div>
      <span class="footer-col-label">{footerLabels.navigation_heading}</span>
      <nav class="footer-nav-links" aria-label="Footer navigation">
        {NAV_PAGES.filter((p) => p.key !== 'home' && (p.key !== 'insights' || hasInsights)).map((p) => (
          <a href={p.href}>{navLabels[p.key]}</a>
        ))}
      </nav>
    </div>
  </div>

  {settings.footer_scope_line && (
    <p class="footer-scope">{settings.footer_scope_line}</p>
  )}

  <div class="footer-bottom">
    <p>&copy; {year} {name}. {footerLabels.rights}</p>
    <a href="/privacy">{footerLabels.privacy_link}</a>
  </div>
</footer>
