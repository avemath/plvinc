---
import settings from '../data/settings.json';
import home from '../data/pages/home.json';
import { e164 } from '../utils/phone';

interface Props {
  title: string;
  description: string;
  image: string;
  siteName: string;
  noindex?: boolean;
  /** Extra JSON-LD for this page, emitted alongside the site-wide business entry. */
  schema?: unknown;
}

const { title, description, image, siteName, noindex = false, schema } = Astro.props;

// Fallback only matters if `site` is ever dropped from astro.config.mjs. Point it at the real
// domain so a misconfiguration produces wrong-but-harmless URLs rather than example.com ones.
const SITE_FALLBACK = 'https://plvinc.com';

// build.format is 'file', so pathname arrives as "/about.html" (and "/index.html" at the root).
// Cloudflare Pages serves those at their extensionless paths, which is what the sitemap and every
// internal link use, so strip the extension rather than declare a canonical nobody links to.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

const canonicalURL = new URL(cleanPath, Astro.site ?? SITE_FALLBACK);

const abs = (u: string) =>
  u.startsWith('http') ? u : new URL(u, Astro.site ?? SITE_FALLBACK).toString();

// Per-page image wins, then the image set in Site Settings, then the generated default so
// a shared link is never a bare text card.
const ogImage = abs(image || settings.seo_share_image || '/images/og-default.png');
// Only the bundled card has a known size; Studio uploads are resized on the way in.
const ogIsDefault = ogImage.endsWith('/images/og-default.png');

// The brand belongs in the tab, the bookmark and the search result, so every title carries it.
// Appending centrally means a title written later in the CMS picks it up without anyone
// remembering to type it, and the guard keeps the Privacy page from saying the name twice.
const brand = siteName.trim();
const fullTitle = brand && !title.includes(brand) ? `${title} | ${brand}` : title;

const s = settings as Record<string, string>;

// A PostalAddress needs at least a region to say anything useful. A locality on its own is
// ambiguous, so state is the one that gates it and city is added when there is one.
const hasAddress = Boolean(s.state);

const siteUrl = Astro.site ?? new URL(SITE_FALLBACK);
const orgId = new URL('/#org', siteUrl).toString();

// The states on the home page coverage map, as places search engines understand. The
// region names in the footer line ("Appalachian Basin") are kept as well.
const states = [...new Set(
  ((home as { regions?: { states?: string[] }[] }).regions ?? []).flatMap((r) => r.states ?? [])
)];

// One business entity, the same on every page, with a stable @id that the people on the
// About page and each service page point back to. Its description is the site-wide one
// rather than whichever page it happens to sit on.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': orgId,
  name: siteName,
  ...(s.legal_name ? { legalName: s.legal_name } : {}),
  description: s.seo_description || description,
  url: new URL('/', siteUrl).toString(),
  image: ogImage,
  ...(s.logo ? { logo: new URL(s.logo, siteUrl).toString() } : {}),
  ...(s.phone ? { telephone: e164(s.phone) } : {}),
  ...(s.email ? { email: s.email } : {}),
  ...(hasAddress
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(s.city ? { addressLocality: s.city } : {}),
          addressRegion: s.state,
          ...(s.postal_code ? { postalCode: s.postal_code } : {}),
          addressCountry: 'US',
        },
      }
    : {}),
  ...((states.length || s.service_area_summary)
    ? {
        areaServed: [
          ...states.map((name) => ({ '@type': 'State', name })),
          ...(s.service_area_summary || '').split('·').map((a) => a.trim()).filter(Boolean),
        ],
      }
    : {}),
  ...(s.linkedin_url ? { sameAs: [s.linkedin_url] } : {}),
};

// Studio text ends up inside these script tags, so "<" is escaped: a stray "</script>"
// in an answer would otherwise end the block early and spill into the page.
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <link rel="canonical" href={canonicalURL} />
}

<meta property="og:type"        content="website" />
<meta property="og:locale"      content="en_US" />
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name"   content={siteName} />
<meta property="og:image"       content={ogImage} />
<meta property="og:image:alt"   content={siteName} />
{ogIsDefault && <meta property="og:image:width"  content="1200" />}
{ogIsDefault && <meta property="og:image:height" content="630" />}

<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImage} />

<script type="application/ld+json" set:html={jsonLd(business)} />
<script type="application/ld+json" set:html={jsonLd({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: new URL('/', siteUrl).toString(),
  name: siteName,
  publisher: { '@id': orgId },
})} />
{schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
