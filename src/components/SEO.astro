---
import settings from '../data/settings.json';

interface Props {
  title: string;
  description: string;
  image: string;
  siteName: string;
  noindex?: boolean;
  /** Extra JSON-LD for this page, emitted alongside the site-wide business entry. */
  schema?: unknown;
}

const { title, description, image, siteName, noindex = false, schema } = Astro.props;

// Fallback only matters if `site` is ever dropped from astro.config.mjs. Point it at the real
// domain so a misconfiguration produces wrong-but-harmless URLs rather than example.com ones.
const SITE_FALLBACK = 'https://plvinc.com';

// build.format is 'file', so pathname arrives as "/about.html" (and "/index.html" at the root).
// Cloudflare Pages serves those at their extensionless paths, which is what the sitemap and every
// internal link use, so strip the extension rather than declare a canonical nobody links to.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

const canonicalURL = new URL(cleanPath, Astro.site ?? SITE_FALLBACK);

const abs = (u: string) =>
  u.startsWith('http') ? u : new URL(u, Astro.site ?? SITE_FALLBACK).toString();

// Per-page image wins, then the image set in Site Settings, then the generated default so
// a shared link is never a bare text card.
const ogImage = abs(image || settings.seo_share_image || '/images/og-default.png');

// The brand belongs in the tab, the bookmark and the search result, so every title carries it.
// Appending centrally means a title written later in the CMS picks it up without anyone
// remembering to type it, and the guard keeps the Privacy page from saying the name twice.
const brand = siteName.trim();
const fullTitle = brand && !title.includes(brand) ? `${title} | ${brand}` : title;

const s = settings as Record<string, string>;

// A PostalAddress needs at least a region to say anything useful. A locality on its own is
// ambiguous, so state is the one that gates it and city is added when there is one.
const hasAddress = Boolean(s.state);

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  ...(s.legal_name ? { legalName: s.legal_name } : {}),
  description,
  url: new URL('/', Astro.site ?? SITE_FALLBACK).toString(),
  image: ogImage,
  ...(s.phone ? { telephone: s.phone } : {}),
  ...(s.email ? { email: s.email } : {}),
  ...(hasAddress
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(s.city ? { addressLocality: s.city } : {}),
          addressRegion: s.state,
          addressCountry: 'US',
        },
      }
    : {}),
  ...(s.service_area_summary
    ? { areaServed: s.service_area_summary.split('·').map((a) => a.trim()).filter(Boolean) }
    : {}),
  ...(s.linkedin_url ? { sameAs: [s.linkedin_url] } : {}),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <link rel="canonical" href={canonicalURL} />
}

<meta property="og:type"        content="website" />
<meta property="og:url"         content={canonicalURL} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name"   content={siteName} />
<meta property="og:image"       content={ogImage} />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(business)} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
