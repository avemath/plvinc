---
interface Props {
  title: string;
  description: string;
  image: string;
  siteName: string;
  noindex?: boolean;
}

const { title, description, image, siteName, noindex = false } = Astro.props;

// Fallback only matters if `site` is ever dropped from astro.config.mjs. Point it at the real
// domain so a misconfiguration produces wrong-but-harmless URLs rather than example.com ones.
const SITE_FALLBACK = 'https://plvinc.com';

// build.format is 'file', so pathname arrives as "/about.html" (and "/index.html" at the root).
// Cloudflare Pages serves those at their extensionless paths, which is what the sitemap and every
// internal link use, so strip the extension rather than declare a canonical nobody links to.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');

const canonicalURL = new URL(cleanPath, Astro.site ?? SITE_FALLBACK);
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site ?? SITE_FALLBACK).toString())
  : '';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <link rel="canonical" href={canonicalURL} />
}

<meta property="og:type"        content="website" />
<meta property="og:url"         content={canonicalURL} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name"   content={siteName} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card"        content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  description,
  url: canonicalURL.toString(),
  ...(ogImage ? { image: ogImage } : {}),
})} />
