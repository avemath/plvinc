---
// A phone-only bar pinned to the bottom of small screens. It hides nothing and
// gates nothing: it is a second copy of the two things a visitor is most likely
// to want, a call and the contact page. Hidden on the contact page itself, where
// both are already on screen.
interface Props {
  phone?: string;
}

const { phone } = Astro.props;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
const onContact = Astro.url.pathname.startsWith('/contact');
---

{phone && !onContact && (
  <div class="sticky-contact" role="complementary" aria-label="Contact shortcuts">
    <a href={telHref} class="sticky-contact-call" aria-label={`Call ${phone}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
      </svg>
      <span>Call</span>
    </a>
    <a href="/contact" class="sticky-contact-write">Send a note</a>
  </div>
)}
