---
import ServiceIcon from './ServiceIcon.astro';
import servicesPage from '../data/pages/services.json';
import { text } from '../utils/labels';

const linkLabel = text((servicesPage as { card_link_label?: string }).card_link_label, 'Learn more');

interface Props {
  title: string;
  card_description: string;
  icon?: string;
  slug: string;
}

const { title, card_description, icon, slug } = Astro.props;
---

<article class="service-card">
  {icon && (
    <div class="service-card-icon">
      <ServiceIcon name={icon} size={36} />
    </div>
  )}
  <h2>{title}</h2>
  <p class="service-card-desc">{card_description}</p>
  <a href={`/services/${slug}`} class="service-card-link">
    {linkLabel}<span class="sr-only"> about {title}</span>
    <span aria-hidden="true">→</span>
  </a>
</article>
