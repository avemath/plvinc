# Cloudflare Pages reads this file and applies these headers to matching responses.
#
# HTML is deliberately not cached here. Saving in /studio rebuilds the site, and the
# owner expects the change to be live in a minute or two; caching pages at the edge
# would break that expectation for the sake of very little.

# Security headers for every response. Cloudflare already adds nosniff and a referrer
# policy; these cover the rest. HSTS is left without includeSubDomains so a subdomain
# that is not on HTTPS (mail, a verification host) is never locked out.
# No Cross-Origin-Opener-Policy: the editor signs in through a GitHub popup that reports
# back to the window that opened it, and that header would cut the link.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The editor is blocked in robots.txt, which also stops crawlers reading its noindex tag,
# so the header says it as well.
/studio/*
  X-Robots-Tag: noindex, nofollow

# The same site is also served at plvinc.pages.dev and at a preview address for every
# deploy. The canonical tag already names plvinc.com, but telling crawlers not to index
# those hosts at all keeps duplicate copies out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Astro fingerprints these filenames, so the content behind a given URL never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames carry the upstream hash and are replaced rather than edited.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Uploads get overwritten under the same name from the CMS, and a long window means a
# replaced photo keeps showing the old one until the cache expires. A day is short enough
# that a swap lands the next time somebody visits, and Cloudflare still absorbs the load.
# When replacing an image that people have already seen, change the filename as well.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate
